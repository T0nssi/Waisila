---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { SESSION_COOKIE } from '../../middleware/auth';

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Admin | ไวยศิลา">
  <div class="min-h-screen bg-[#e0dcd7]">
    <!-- Header -->
    <header class="bg-white border-b border-[#d4d0cb] sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <h1 class="text-xl font-serif">Admin Panel</h1>
          <span class="text-brown/40">|</span>
          <span class="text-sm text-brown/60">ไวยศิลา</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" target="_blank" class="text-sm text-brown/60 hover:text-sage transition-colors">
            ดูเว็บไซต์ →
          </a>
          <button id="logoutBtn" class="text-sm text-red-500 hover:text-red-600 transition-colors">
            ออกจากระบบ
          </button>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-6 py-8">
      <!-- Main Tab Navigation -->
      <div class="flex gap-2 mb-6">
        <button data-main="products" class="main-tab px-6 py-3 rounded-md text-sm font-medium bg-terracotta text-cream">สินค้า</button>
        <button data-main="portfolio" class="main-tab px-6 py-3 rounded-md text-sm font-medium bg-white text-brown border border-[#d4d0cb]">ผลงาน</button>
        <a href="/admin/pages" class="px-6 py-3 rounded-md text-sm font-medium bg-white text-brown border border-[#d4d0cb] hover:bg-[#f5f3f0] transition-colors">หน้าเพจ</a>
      </div>


      <!-- PRODUCTS SECTION -->
      <div id="productsSection">
        <!-- Stats -->
        <div class="grid grid-cols-4 gap-4 mb-8">
          <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
            <p class="text-xs text-brown/50 mb-1">หินอ่อน</p>
            <p class="text-2xl font-serif" id="count-marble">-</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
            <p class="text-xs text-brown/50 mb-1">หินแกรนิต</p>
            <p class="text-2xl font-serif" id="count-granite">-</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
            <p class="text-xs text-brown/50 mb-1">หินเทียม</p>
            <p class="text-2xl font-serif" id="count-artificial">-</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
            <p class="text-xs text-brown/50 mb-1">หินควอทซ์</p>
            <p class="text-2xl font-serif" id="count-quartz">-</p>
          </div>
        </div>

        <!-- Product Tabs -->
        <div class="bg-white rounded-md border border-[#d4d0cb]">
          <div class="flex border-b border-[#d4d0cb]">
            <button data-tab="marble" class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-sage text-sage">หินอ่อน</button>
            <button data-tab="granite" class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">หินแกรนิต</button>
            <button data-tab="artificial" class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">หินเทียม</button>
            <button data-tab="quartz" class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">หินควอทซ์</button>
          </div>

          <!-- Actions -->
          <div class="p-4 border-b border-[#d4d0cb] flex justify-between items-center">
            <p class="text-sm text-brown/60"><span id="totalCount">-</span> รายการ</p>
            <button id="addBtn" class="bg-terracotta text-cream px-4 py-2 rounded-md text-sm font-medium hover:bg-terracotta/90 transition-colors">
              + เพิ่มสินค้าใหม่
            </button>
          </div>

          <!-- Table -->
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-[#f5f3f0]">
                <tr>
                  <th class="text-left px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">ชื่อ</th>
                  <th class="text-left px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">Slug</th>
                  <th class="text-center px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">สถานะ</th>
                  <th class="text-center px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">จัดการ</th>
                </tr>
              </thead>
              <tbody id="productTable" class="divide-y divide-[#d4d0cb]">
                <tr><td colspan="4" class="px-4 py-8 text-center text-brown/40">กำลังโหลด...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- PORTFOLIO SECTION (Hidden by default) -->
      <div id="portfolioSection" class="hidden">
        <!-- Stats -->
        <div class="grid grid-cols-4 gap-4 mb-8">
          <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
            <p class="text-xs text-brown/50 mb-1">หินอ่อน</p>
            <p class="text-2xl font-serif" id="pf-count-stone">-</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
            <p class="text-xs text-brown/50 mb-1">โรงงาน</p>
            <p class="text-2xl font-serif" id="pf-count-factory">-</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
            <p class="text-xs text-brown/50 mb-1">อาคาร</p>
            <p class="text-2xl font-serif" id="pf-count-office">-</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
            <p class="text-xs text-brown/50 mb-1">บ้าน</p>
            <p class="text-2xl font-serif" id="pf-count-home">-</p>
          </div>
        </div>

        <!-- Portfolio Tabs -->
        <div class="bg-white rounded-md border border-[#d4d0cb]">
          <div class="flex border-b border-[#d4d0cb]">
            <button data-pf-tab="stone" class="pf-tab-btn px-6 py-4 text-sm font-medium border-b-2 border-sage text-sage">หินอ่อน/แกรนิต</button>
            <button data-pf-tab="factory" class="pf-tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">โรงงาน</button>
            <button data-pf-tab="office" class="pf-tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">อาคารสำนักงาน</button>
            <button data-pf-tab="home" class="pf-tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">บ้านเรือน</button>
          </div>

          <!-- Actions -->
          <div class="p-4 border-b border-[#d4d0cb] flex justify-between items-center">
            <p class="text-sm text-brown/60"><span id="pf-totalCount">-</span> รายการ</p>
            <button id="addPfBtn" class="bg-terracotta text-cream px-4 py-2 rounded-md text-sm font-medium hover:bg-terracotta/90 transition-colors">
              + เพิ่มผลงานใหม่
            </button>
          </div>

          <!-- Table -->
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-[#f5f3f0]">
                <tr>
                  <th class="text-left px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">ชื่อ</th>
                  <th class="text-left px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">Slug</th>
                  <th class="text-center px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">สถานะ</th>
                  <th class="text-center px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">จัดการ</th>
                </tr>
              </thead>
              <tbody id="portfolioTable" class="divide-y divide-[#d4d0cb]">
                <tr><td colspan="4" class="px-4 py-8 text-center text-brown/40">กำลังโหลด...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

  <div id="modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-[#d4d0cb] px-6 py-4 flex items-center justify-between">
        <h2 id="modalTitle" class="text-lg font-serif">เพิ่มสินค้าใหม่</h2>
        <button id="closeModal" class="text-brown/60 hover:text-brown">&times;</button>
      </div>
      <form id="productForm" class="p-6 space-y-4">
        <input type="hidden" name="id" id="productId" />
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">ชื่อ (ไทย) *</label>
            <input type="text" name="name" id="name" required class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">ชื่อ (EN)</label>
            <input type="text" name="en" id="en" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">Slug</label>
            <input type="text" name="slug" id="slug" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
            <p class="text-xs text-brown/40 mt-1">ว่างไว้ = สร้างอัตโนมัติ</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">หมวดหมู่ *</label>
            <select name="category" id="category" required class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50">
              <option value="marble">หินอ่อน</option>
              <option value="granite">หินแกรนิต</option>
              <option value="artificial">หินเทียม</option>
              <option value="quartz">หินควอทซ์</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brown mb-2">รูปภาพ (path)</label>
          <input type="text" name="image" id="image" placeholder="/assets/products/marble/example.jpg" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          <div id="imagePreview" class="mt-2 hidden">
            <img id="previewImg" src="" alt="Preview" class="w-32 h-32 object-cover rounded-md border border-[#d4d0cb]" />
          </div>
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">แหล่งที่มา</label>
            <input type="text" name="origin" id="origin" placeholder="เช่น อิตาลี" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">ผิว</label>
            <input type="text" name="finish" id="finish" placeholder="เช่น Polish" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">การใช้งาน</label>
            <input type="text" name="usage" id="usage" placeholder="เช่น พื้น, ผนัง" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
        </div>

        <div class="flex items-center gap-4 pt-4 border-t border-[#d4d0cb]">
          <button type="submit" class="bg-terracotta text-cream px-6 py-2 rounded-md font-medium hover:bg-terracotta/90 transition-colors">
            บันทึก
          </button>
          <button type="button" id="cancelBtn" class="px-6 py-2 border border-[#d4d0cb] rounded-md font-medium hover:bg-brown/5 transition-colors">
            ยกเลิก
          </button>
        </div>
      </form>
    </div>
  </div>

  <div id="portfolioModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-[#d4d0cb] px-6 py-4 flex items-center justify-between">
        <h2 id="portfolioModalTitle" class="text-lg font-serif">เพิ่มผลงานใหม่</h2>
        <button id="closePortfolioModal" class="text-brown/60 hover:text-brown">&times;</button>
      </div>
      <form id="portfolioForm" class="p-6 space-y-4">
        <input type="hidden" name="id" id="portfolioId" />
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">ชื่อ *</label>
            <input type="text" name="title" id="pfTitle" required class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">Slug</label>
            <input type="text" name="slug" id="pfSlug" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
            <p class="text-xs text-brown/40 mt-1">ว่างไว้ = สร้างอัตโนมัติ</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">ประเภท *</label>
            <select name="type" id="pfType" required class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50">
              <option value="stone">หินอ่อน/แกรนิต</option>
              <option value="factory">โรงงาน</option>
              <option value="office">อาคารสำนักงาน</option>
              <option value="home">บ้านเรือน</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">หมวดหมู่</label>
            <input type="text" name="category" id="pfCategory" placeholder="เช่น หินอ่อน, หินแกรนิต" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brown mb-2">รูปภาพหลัก (path)</label>
          <input type="text" name="image" id="pfImage" placeholder="/assets/portfolio/marble-01.jpg" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          <div id="pfImagePreview" class="mt-2 hidden">
            <img id="pfPreviewImg" src="" alt="Preview" class="w-32 h-32 object-cover rounded-md border border-[#d4d0cb]" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brown mb-2">รูปภาพเพิ่มเติม (หลายรูป)</label>
          <textarea name="images" id="pfImages" rows="3" placeholder="วาง URL รูปภาพ แต่ละรูปขึ้นบรรทัดใหม่" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs"></textarea>
          <div id="pfImagesPreview" class="mt-2 flex flex-wrap gap-2"></div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brown mb-2">รายละเอียด</label>
          <textarea name="description" id="pfDescription" rows="3" placeholder="รายละเอียดผลงาน..." class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50"></textarea>
        </div>

        <div class="flex items-center gap-4 pt-4 border-t border-[#d4d0cb]">
          <button type="submit" class="bg-terracotta text-cream px-6 py-2 rounded-md font-medium hover:bg-terracotta/90 transition-colors">
            บันทึก
          </button>
          <button type="button" id="cancelPortfolioBtn" class="px-6 py-2 border border-[#d4d0cb] rounded-md font-medium hover:bg-brown/5 transition-colors">
            ยกเลิก
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirm Modal -->
  <div id="deleteModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-md p-6 text-center">
      <h3 class="text-lg font-serif mb-4">ยืนยันการลบ?</h3>
      <p class="text-brown/60 mb-6" id="deleteProductName"></p>
      <div class="flex gap-4 justify-center">
        <button id="confirmDelete" class="bg-red-500 text-white px-6 py-2 rounded-md font-medium hover:bg-red-600 transition-colors">
          ลบ
        </button>
        <button id="cancelDelete" class="px-6 py-2 border border-[#d4d0cb] rounded-md font-medium hover:bg-brown/5 transition-colors">
          ยกเลิก
        </button>
      </div>
    </div>
  </div>

  <!-- Delete Portfolio Confirm Modal -->
  <div id="deletePfModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-md p-6 text-center">
      <h3 class="text-lg font-serif mb-4">ยืนยันการลบ?</h3>
      <p class="text-brown/60 mb-6" id="deletePfName"></p>
      <div class="flex gap-4 justify-center">
        <button id="confirmPfDelete" class="bg-red-500 text-white px-6 py-2 rounded-md font-medium hover:bg-red-600 transition-colors">
          ลบ
        </button>
        <button id="cancelPfDelete" class="px-6 py-2 border border-[#d4d0cb] rounded-md font-medium hover:bg-brown/5 transition-colors">
          ยกเลิก
        </button>
      </div>
    </div>
  </div>

  <!-- Upload Modal -->
  <div id="uploadModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-lg">
      <div class="border-b border-[#d4d0cb] px-6 py-4 flex items-center justify-between">
        <h2 class="text-lg font-serif">อัพโหลดรูปภาพ</h2>
        <button id="closeUploadModal" class="text-brown/60 hover:text-brown text-2xl">&times;</button>
      </div>
      <div class="p-6">
        <!-- Upload Target Input -->
        <input type="hidden" id="uploadTargetInput" value="" />
        <input type="hidden" id="uploadTargetType" value="product" />

        <!-- Method Tabs -->
        <div class="flex border-b border-[#d4d0cb] mb-4">
          <button id="tabLocal" class="px-4 py-2 text-sm font-medium border-b-2 border-sage text-sage">อัพโหลดไฟล์</button>
          <button id="tabCloudinary" class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-brown/60">Cloudinary</button>
        </div>

        <!-- Local Upload -->
        <div id="localUploadPanel">
          <div class="mb-4">
            <label class="block text-sm font-medium text-brown mb-2">โฟลเดอร์</label>
            <select id="uploadFolder" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50">
              <option value="products/marble">products/marble</option>
              <option value="products/granite">products/granite</option>
              <option value="products/quartz">products/quartz</option>
              <option value="products/artificial">products/artificial</option>
              <option value="portfolio">portfolio</option>
              <option value="images">images</option>
            </select>
          </div>
          <div class="border-2 border-dashed border-[#d4d0cb] rounded-lg p-8 text-center hover:border-sage transition-colors cursor-pointer" id="dropZone">
            <input type="file" id="fileInput" accept="image/*" class="hidden" />
            <div id="dropZoneContent">
              <svg class="w-12 h-12 mx-auto text-brown/30 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-brown/60 mb-1">คลิกเลือกไฟล์ หรือ ลากไฟล์มาวาง</p>
              <p class="text-xs text-brown/40">รองรับ JPG, PNG, WebP, GIF (max 5MB)</p>
            </div>
            <div id="filePreview" class="hidden">
              <img id="previewBeforeUpload" src="" class="max-h-40 mx-auto rounded-lg mb-2" />
              <p id="fileName" class="text-sm text-brown/60"></p>
            </div>
          </div>
          <button id="uploadLocalBtn" class="mt-4 w-full bg-terracotta text-cream px-6 py-3 rounded-md font-medium hover:bg-terracotta/90 transition-colors disabled:bg-brown/30" disabled>
            อัพโหลดไฟล์
          </button>
        </div>

        <!-- Cloudinary Upload -->
        <div id="cloudinaryUploadPanel" class="hidden">
          <div class="mb-4">
            <label class="block text-sm font-medium text-brown mb-2">Cloudinary URL</label>
            <input type="text" id="cloudinaryUrl" placeholder="https://res.cloudinary.com/.../image.jpg" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
            <p class="text-xs text-brown/40 mt-1">วาง URL รูปภาพจาก Cloudinary</p>
          </div>
          <div class="bg-sage/10 rounded-lg p-4 mb-4">
            <p class="text-sm text-sage font-medium mb-2">📋 วิธีใช้ Cloudinary</p>
            <ol class="text-xs text-brown/70 space-y-1">
              <li>1. สมัคร account ที่ <a href="https://cloudinary.com" target="_blank" class="text-sage hover:underline">cloudinary.com</a> (ฟรี)</li>
              <li>2. อัพโหลดรูปใน Dashboard</li>
              <li>3. คลิกรูป → Copy URL</li>
              <li>4. วาง URL ด้านบน</li>
            </ol>
          </div>
          <button id="useCloudinaryBtn" class="w-full bg-sage text-cream px-6 py-3 rounded-md font-medium hover:bg-sage/90 transition-colors">
            ใช้ URL นี้
          </button>
        </div>

        <!-- Upload Status -->
        <div id="uploadStatus" class="mt-4 text-center text-sm hidden"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    let products = [];
    let portfolio = [];
    let currentCategory = 'marble';
    let currentPfCategory = 'stone';
    let deleteTargetId = null;
    let deletePfTargetId = null;

    const modal = document.getElementById('modal');
    const portfolioModal = document.getElementById('portfolioModal');
    const deleteModal = document.getElementById('deleteModal');
    const deletePfModal = document.getElementById('deletePfModal');
    const productForm = document.getElementById('productForm');
    const portfolioForm = document.getElementById('portfolioForm');
    const productTable = document.getElementById('productTable');
    const portfolioTable = document.getElementById('portfolioTable');

    // Main tab switching
    document.querySelectorAll('.main-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.main-tab').forEach(b => {
          b.classList.remove('bg-terracotta', 'text-cream');
          b.classList.add('bg-white', 'text-brown', 'border', 'border-[#d4d0cb]');
        });
        btn.classList.add('bg-terracotta', 'text-cream');
        btn.classList.remove('bg-white', 'text-brown', 'border', 'border-[#d4d0cb]');
        
        const main = btn.dataset.main;
        if (main === 'products') {
          document.getElementById('productsSection').classList.remove('hidden');
          document.getElementById('portfolioSection').classList.add('hidden');
        } else if (main === 'portfolio') {
          document.getElementById('productsSection').classList.add('hidden');
          document.getElementById('portfolioSection').classList.remove('hidden');
          loadPortfolio();
        }
      });
    });

    // Load products
    async function loadProducts() {
      try {
        const res = await fetch('/api/admin/products', { credentials: 'include' });
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        products = await res.json();
        updateStats();
        renderTable();
      } catch (err) { console.error(err); }
    }

    function updateStats() {
      document.getElementById('count-marble').textContent = products.filter(p => p.category === 'marble').length;
      document.getElementById('count-granite').textContent = products.filter(p => p.category === 'granite').length;
      document.getElementById('count-artificial').textContent = products.filter(p => p.category === 'artificial').length;
      document.getElementById('count-quartz').textContent = products.filter(p => p.category === 'quartz').length;
    }

    function renderTable() {
      const filtered = products.filter(p => p.category === currentCategory);
      document.getElementById('totalCount').textContent = filtered.length;
      
      if (filtered.length === 0) {
        productTable.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-brown/40">ไม่มีสินค้าในหมวดนี้</td></tr>';
        return;
      }

      productTable.innerHTML = filtered.map(p => `
        <tr class="hover:bg-[#f5f3f0]/50">
          <td class="px-4 py-3">
            <div class="flex items-center gap-3">
              ${p.image ? `<img src="${p.image}" class="w-10 h-10 object-cover rounded bg-[#d4d0cb]" />` : '<div class="w-10 h-10 rounded bg-[#d4d0cb]"></div>'}
              <div>
                <p class="font-medium">${p.name}</p>
                <p class="text-xs text-brown/50">${p.en || '-'}</p>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 text-sm text-brown/60 font-mono">${p.slug}</td>
          <td class="px-4 py-3 text-center">
            <button data-id="${p.id}" data-active="${p.active}" class="toggle-btn px-3 py-1 rounded-full text-xs font-medium ${p.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
              ${p.active ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}
            </button>
          </td>
          <td class="px-4 py-3 text-center">
            <button data-id="${p.id}" class="clone-btn text-sm text-blue-500 hover:underline mr-3">คัดลอก</button>
            <button data-id="${p.id}" class="edit-btn text-sm text-sage hover:underline mr-3">แก้ไข</button>
            <button data-id="${p.id}" data-name="${p.name}" class="delete-btn text-sm text-red-500 hover:underline">ลบ</button>
          </td>
        </tr>
      `).join('');

      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => toggleActive(btn.dataset.id, btn.dataset.active === 'true'));
      });
      document.querySelectorAll('.clone-btn').forEach(btn => {
        btn.addEventListener('click', () => cloneProduct(btn.dataset.id));
      });
      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', () => editProduct(btn.dataset.id));
      });
      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', () => showDeleteConfirm(btn.dataset.id, btn.dataset.name));
      });
    }

    // Product tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('border-sage', 'text-sage');
          b.classList.add('border-transparent', 'text-brown/60');
        });
        btn.classList.add('border-sage', 'text-sage');
        btn.classList.remove('border-transparent', 'text-brown/60');
        currentCategory = btn.dataset.tab;
        document.getElementById('category').value = currentCategory;
        renderTable();
      });
    });

    // Add product button
    document.getElementById('addBtn').addEventListener('click', () => {
      document.getElementById('modalTitle').textContent = 'เพิ่มสินค้าใหม่';
      document.getElementById('productId').value = '';
      productForm.reset();
      document.getElementById('category').value = currentCategory;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });

    // Clone product
    function cloneProduct(id) {
      const p = products.find(pr => pr.id === id);
      if (!p) return;
      const newSlug = p.slug + '-copy-' + Date.now().toString(36);
      const clonedData = { ...p, id: undefined, slug: newSlug, name: p.name + ' (คัดลอก)', en: p.en ? p.en + ' (copy)' : '', active: false, sort: p.sort + 1 };
      fetch('/api/admin/products', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(clonedData), credentials: 'include' }).then(res => { if (res.ok) loadProducts(); });
    }

    // Edit product
    function editProduct(id) {
      const p = products.find(pr => pr.id === id);
      if (!p) return;
      document.getElementById('modalTitle').textContent = 'แก้ไขสินค้า';
      document.getElementById('productId').value = p.id;
      document.getElementById('name').value = p.name || '';
      document.getElementById('slug').value = p.slug || '';
      document.getElementById('category').value = p.category || currentCategory;
      document.getElementById('image').value = p.image || '';
      document.getElementById('origin').value = p.origin || '';
      document.getElementById('finish').value = p.finish || 'Polish';
      document.getElementById('usage').value = p.usage || '';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    // Toggle product active
    async function toggleActive(id, currentActive) {
      try {
        const res = await fetch('/api/admin/products', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, active: !currentActive }), credentials: 'include' });
        if (res.ok) loadProducts();
      } catch (err) { console.error(err); }
    }

    // Delete product confirm
    function showDeleteConfirm(id, name) {
      deleteTargetId = id;
      document.getElementById('deleteName').textContent = `ลบ "${name}" ?`;
      deleteModal.classList.remove('hidden');
      deleteModal.classList.add('flex');
    }

    document.getElementById('confirmDelete').addEventListener('click', async () => {
      if (!deleteTargetId) return;
      try {
        const res = await fetch(`/api/admin/products?id=${deleteTargetId}`, { method: 'DELETE', credentials: 'include' });
        if (res.ok) { deleteModal.classList.add('hidden'); deleteModal.classList.remove('flex'); loadProducts(); }
      } catch (err) { console.error(err); }
    });
    document.getElementById('cancelDelete').addEventListener('click', () => { deleteModal.classList.add('hidden'); deleteModal.classList.remove('flex'); });

    // Product form submit
    productForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      const isEdit = !!data.id;
      const method = isEdit ? 'PUT' : 'POST';
      try {
        const res = await fetch('/api/admin/products', { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data), credentials: 'include' });
        if (res.ok) { modal.classList.add('hidden'); modal.classList.remove('flex'); loadProducts(); }
      } catch (err) { console.error(err); }
    });

    // Close product modal
    document.getElementById('closeModal').addEventListener('click', () => { modal.classList.add('hidden'); modal.classList.remove('flex'); });
    document.getElementById('cancelBtn').addEventListener('click', () => { modal.classList.add('hidden'); modal.classList.remove('flex'); });

    // Product image preview
    const imageInput = document.getElementById('image');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    imageInput.addEventListener('input', () => {
      const src = imageInput.value.trim();
      if (src) { previewImg.src = src; imagePreview.classList.remove('hidden'); previewImg.onerror = () => { previewImg.src = '/assets/placeholder.jpg'; }; }
      else { imagePreview.classList.add('hidden'); }
    });

    // Load portfolio
    async function loadPortfolio() {
      try {
        const res = await fetch('/api/admin/portfolio', { credentials: 'include' });
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        portfolio = await res.json();
        updatePfStats();
        renderPfTable();
      } catch (err) { console.error(err); }
    }

    function updatePfStats() {
      document.getElementById('pf-count-stone').textContent = portfolio.filter(p => p.type === 'stone').length;
      document.getElementById('pf-count-factory').textContent = portfolio.filter(p => p.type === 'factory').length;
      document.getElementById('pf-count-office').textContent = portfolio.filter(p => p.type === 'office').length;
      document.getElementById('pf-count-home').textContent = portfolio.filter(p => p.type === 'home').length;
    }

    function renderPfTable() {
      const filtered = portfolio.filter(p => p.type === currentPfCategory);
      document.getElementById('pf-totalCount').textContent = filtered.length;
      
      if (filtered.length === 0) {
        portfolioTable.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-brown/40">ไม่มีผลงานในหมวดนี้</td></tr>';
        return;
      }

      portfolioTable.innerHTML = filtered.map(p => `
        <tr class="hover:bg-[#f5f3f0]/50">
          <td class="px-4 py-3">
            <div class="flex items-center gap-3">
              ${p.image ? `<img src="${p.image}" class="w-10 h-10 object-cover rounded bg-[#d4d0cb]" />` : '<div class="w-10 h-10 rounded bg-[#d4d0cb]"></div>'}
              <div>
                <p class="font-medium">${p.title}</p>
                <p class="text-xs text-brown/50">${p.category || '-'}</p>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 text-sm text-brown/60 font-mono">${p.slug}</td>
          <td class="px-4 py-3 text-center">
            <button data-id="${p.id}" data-active="${p.active}" class="pf-toggle-btn px-3 py-1 rounded-full text-xs font-medium ${p.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
              ${p.active ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}
            </button>
          </td>
          <td class="px-4 py-3 text-center">
            <button data-id="${p.id}" class="pf-clone-btn text-sm text-blue-500 hover:underline mr-3">คัดลอก</button>
            <button data-id="${p.id}" class="pf-edit-btn text-sm text-sage hover:underline mr-3">แก้ไข</button>
            <button data-id="${p.id}" data-title="${p.title}" class="pf-delete-btn text-sm text-red-500 hover:underline">ลบ</button>
          </td>
        </tr>
      `).join('');

      document.querySelectorAll('.pf-toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => togglePfActive(btn.dataset.id, btn.dataset.active === 'true'));
      });
      document.querySelectorAll('.pf-clone-btn').forEach(btn => {
        btn.addEventListener('click', () => clonePortfolio(btn.dataset.id));
      });
      document.querySelectorAll('.pf-edit-btn').forEach(btn => {
        btn.addEventListener('click', () => editPortfolio(btn.dataset.id));
      });
      document.querySelectorAll('.pf-delete-btn').forEach(btn => {
        btn.addEventListener('click', () => showPfDeleteConfirm(btn.dataset.id, btn.dataset.title));
      });
    }

    // Portfolio tab switching
    document.querySelectorAll('.pf-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.pf-tab-btn').forEach(b => {
          b.classList.remove('border-sage', 'text-sage');
          b.classList.add('border-transparent', 'text-brown/60');
        });
        btn.classList.add('border-sage', 'text-sage');
        btn.classList.remove('border-transparent', 'text-brown/60');
        currentPfCategory = btn.dataset.pfTab;
        document.getElementById('pfType').value = currentPfCategory;
        renderPfTable();
      });
    });

    // Add portfolio button
    document.getElementById('addPfBtn').addEventListener('click', () => {
      document.getElementById('portfolioModalTitle').textContent = 'เพิ่มผลงานใหม่';
      document.getElementById('portfolioId').value = '';
      portfolioForm.reset();
      document.getElementById('pfType').value = currentPfCategory;
      updatePfImagePreview('');
      updatePfImagesPreview([]);
      portfolioModal.classList.remove('hidden');
      portfolioModal.classList.add('flex');
    });

    // Clone portfolio
    function clonePortfolio(id) {
      const p = portfolio.find(pr => pr.id === id);
      if (!p) return;
      const newSlug = p.slug + '-copy-' + Date.now().toString(36);
      const clonedData = {
        ...p,
        id: undefined,
        slug: newSlug,
        title: p.title + ' (คัดลอก)',
        active: false,
        sort: p.sort + 1
      };
      fetch('/api/admin/portfolio', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(clonedData),
        credentials: 'include'
      }).then(res => {
        if (res.ok) {
          loadPortfolio();
        }
      });
    }

    // Edit portfolio
    function editPortfolio(id) {
      const p = portfolio.find(pr => pr.id === id);
      if (!p) return;
      document.getElementById('portfolioModalTitle').textContent = 'แก้ไขผลงาน';
      document.getElementById('portfolioId').value = p.id;
      document.getElementById('pfTitle').value = p.title;
      document.getElementById('pfSlug').value = p.slug || '';
      document.getElementById('pfType').value = p.type;
      document.getElementById('pfCategory').value = p.category || '';
      document.getElementById('pfImage').value = p.image || '';
      document.getElementById('pfImages').value = (p.images || []).join('\n');
      updatePfImagePreview(p.image || '');
      updatePfImagesPreview(p.images || []);
      document.getElementById('pfDescription').value = p.description || '';
      portfolioModal.classList.remove('hidden');
      portfolioModal.classList.add('flex');
    }

    // Toggle portfolio active
    async function togglePfActive(id, currentActive) {
      try {
        const res = await fetch('/api/admin/portfolio', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, active: !currentActive }),
          credentials: 'include'
        });
        if (res.ok) loadPortfolio();
      } catch (err) { console.error(err); }
    }

    // Portfolio delete confirm
    function showPfDeleteConfirm(id, title) {
      deletePfTargetId = id;
      document.getElementById('deletePfName').textContent = `ลบ "${title}" ?`;
      deletePfModal.classList.remove('hidden');
      deletePfModal.classList.add('flex');
    }

    document.getElementById('confirmPfDelete').addEventListener('click', async () => {
      if (!deletePfTargetId) return;
      try {
        const res = await fetch(`/api/admin/portfolio?id=${deletePfTargetId}`, {
          method: 'DELETE',
          credentials: 'include'
        });
        if (res.ok) {
          deletePfModal.classList.add('hidden');
          deletePfModal.classList.remove('flex');
          loadPortfolio();
        }
      } catch (err) { console.error(err); }
    });

    document.getElementById('cancelPfDelete').addEventListener('click', () => {
      deletePfModal.classList.add('hidden');
      deletePfModal.classList.remove('flex');
    });

    // Portfolio form submit
    portfolioForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data: any = Object.fromEntries(formData);
      
      // Convert pfImages newline-separated to array
      const pfImagesVal = document.getElementById('pfImages').value.trim();
      data.images = pfImagesVal ? pfImagesVal.split('\n').map((s: string) => s.trim()).filter(Boolean) : [];
      
      const isEdit = !!data.id;
      const method = isEdit ? 'PUT' : 'POST';
      
      try {
        const res = await fetch('/api/admin/portfolio', {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });
        
        if (res.ok) {
          portfolioModal.classList.add('hidden');
          portfolioModal.classList.remove('flex');
          loadPortfolio();
        }
      } catch (err) { console.error(err); }
    });

    // Close portfolio modal
    document.getElementById('closePortfolioModal').addEventListener('click', () => {
      portfolioModal.classList.add('hidden');
      portfolioModal.classList.remove('flex');
    });
    document.getElementById('cancelPortfolioBtn').addEventListener('click', () => {
      portfolioModal.classList.add('hidden');
      portfolioModal.classList.remove('flex');
    });

    // Portfolio image preview
    const pfImageInput = document.getElementById('pfImage');
    const pfImagePreview = document.getElementById('pfImagePreview');
    const pfPreviewImg = document.getElementById('pfPreviewImg');
    const pfImagesInput = document.getElementById('pfImages');
    const pfImagesPreview = document.getElementById('pfImagesPreview');
    
    function updatePfImagePreview(src: string) {
      if (src) {
        pfPreviewImg.src = src;
        pfImagePreview.classList.remove('hidden');
        pfPreviewImg.onerror = () => { pfPreviewImg.src = '/assets/placeholder.jpg'; };
      } else {
        pfImagePreview.classList.add('hidden');
      }
    }
    
    function updatePfImagesPreview(urls: string[]) {
      if (!urls || urls.length === 0) {
        pfImagesPreview.innerHTML = '';
        return;
      }
      pfImagesPreview.innerHTML = urls.map(url => `
        <div class="relative group">
          <img src="${url}" class="w-20 h-20 object-cover rounded border border-[#d4d0cb]" />
          <button type="button" onclick="this.parentElement.remove(); updatePfImagesFromDom()" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-5 h-5 text-xs leading-none opacity-0 group-hover:opacity-100 transition-opacity">×</button>
        </div>
      `).join('');
    }
    
    // Global function for remove buttons
    (window as any).updatePfImagesFromDom = () => {
      const imgs = pfImagesPreview.querySelectorAll('img');
      pfImagesInput.value = Array.from(imgs).map((img: any) => img.src).join('\n');
    };
    
    pfImageInput.addEventListener('input', () => {
      updatePfImagePreview(pfImageInput.value.trim());
    });
    
    pfImagesInput.addEventListener('input', () => {
      const urls = pfImagesInput.value.split('\n').map((s: string) => s.trim()).filter(Boolean);
      updatePfImagesPreview(urls);
    });


    // Logout
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      await fetch('/api/admin/logout', { credentials: 'include' });
      window.location.href = '/admin/login';
    });

    // Init
    loadProducts();
  </script>
</Layout>
