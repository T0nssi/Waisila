---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SESSION_COOKIE } from '../../middleware/auth';

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="Admin | ไวยศิลา">
  <!-- Header -->
  <header class="bg-white border-b border-[#d4d0cb] sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <a href="/admin" class="text-sm text-brown/60 hover:text-sage font-medium">📦 Admin</a>
        <span class="text-brown/30">|</span>
        <a href="/" class="text-sm text-brown/60 hover:text-sage">ดูเว็บไซต์</a>
      </div>
      <button id="logoutBtn" class="text-sm text-red-500 hover:text-red-600 transition-colors">
        ออกจากระบบ
      </button>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-6 py-8">
    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-6">
      <button data-main="products" class="main-tab px-6 py-3 rounded-md text-sm font-medium bg-terracotta text-cream">สินค้า</button>
      <button data-main="portfolio" class="main-tab px-6 py-3 rounded-md text-sm font-medium bg-white text-brown border border-[#d4d0cb]">ผลงาน</button>
      <a href="/admin/pages" class="px-6 py-3 rounded-md text-sm font-medium bg-white text-brown border border-[#d4d0cb] hover:bg-[#f5f3f0] transition-colors">หน้าเพจ</a>
    </div>

    <!-- PRODUCTS SECTION -->
    <div id="productsSection">
      <!-- Stats -->
      <div class="grid grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
          <p class="text-xs text-brown/50 mb-1">หินอ่อน</p>
          <p class="text-2xl font-serif" id="count-marble">-</p>
        </div>
        <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
          <p class="text-xs text-brown/50 mb-1">หินแกรนิต</p>
          <p class="text-2xl font-serif" id="count-granite">-</p>
        </div>
        <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
          <p class="text-xs text-brown/50 mb-1">หินเทียม</p>
          <p class="text-2xl font-serif" id="count-artificial">-</p>
        </div>
        <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
          <p class="text-xs text-brown/50 mb-1">หินควอทซ์</p>
          <p class="text-2xl font-serif" id="count-quartz">-</p>
        </div>
      </div>

      <!-- Product Tabs -->
      <div class="bg-white rounded-md border border-[#d4d0cb]">
        <div class="flex border-b border-[#d4d0cb]">
          <button data-tab="marble" class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-sage text-sage">หินอ่อน</button>
          <button data-tab="granite" class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">หินแกรนิต</button>
          <button data-tab="artificial" class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">หินเทียม</button>
          <button data-tab="quartz" class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">หินควอทซ์</button>
        </div>

        <!-- Actions -->
        <div class="p-4 border-b border-[#d4d0cb] flex justify-between items-center">
          <p class="text-sm text-brown/60"><span id="totalCount">-</span> รายการ</p>
          <button id="addBtn" class="bg-terracotta text-cream px-4 py-2 rounded-md text-sm font-medium hover:bg-terracotta/90 transition-colors">
            + เพิ่มสินค้าใหม่
          </button>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-[#f5f3f0]">
              <tr>
                <th class="text-left px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">ชื่อ</th>
                <th class="text-left px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">Slug</th>
                <th class="text-center px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">สถานะ</th>
                <th class="text-center px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">จัดการ</th>
              </tr>
            </thead>
            <tbody id="productTable" class="divide-y divide-[#d4d0cb]">
              <tr><td colspan="4" class="px-4 py-8 text-center text-brown/40">กำลังโหลด...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- PORTFOLIO SECTION (Hidden by default) -->
    <div id="portfolioSection" class="hidden">
      <!-- Stats -->
      <div class="grid grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
          <p class="text-xs text-brown/50 mb-1">หินอ่อน/แกรนิต</p>
          <p class="text-2xl font-serif" id="pf-count-stone">-</p>
        </div>
        <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
          <p class="text-xs text-brown/50 mb-1">โรงงาน</p>
          <p class="text-2xl font-serif" id="pf-count-factory">-</p>
        </div>
        <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
          <p class="text-xs text-brown/50 mb-1">อาคารสำนักงาน</p>
          <p class="text-2xl font-serif" id="pf-count-office">-</p>
        </div>
        <div class="bg-white rounded-md p-4 border border-[#d4d0cb]">
          <p class="text-xs text-brown/50 mb-1">บ้านเรือน</p>
          <p class="text-2xl font-serif" id="pf-count-home">-</p>
        </div>
      </div>

      <!-- Portfolio Tabs -->
      <div class="bg-white rounded-md border border-[#d4d0cb]">
        <div class="flex border-b border-[#d4d0cb]">
          <button data-pf-tab="stone" class="pf-tab-btn px-6 py-4 text-sm font-medium border-b-2 border-sage text-sage">หินอ่อน/แกรนิต</button>
          <button data-pf-tab="factory" class="pf-tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">โรงงาน</button>
          <button data-pf-tab="office" class="pf-tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">อาคารสำนักงาน</button>
          <button data-pf-tab="home" class="pf-tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-brown/60">บ้านเรือน</button>
        </div>

        <!-- Actions -->
        <div class="p-4 border-b border-[#d4d0cb] flex justify-between items-center">
          <p class="text-sm text-brown/60"><span id="pf-totalCount">-</span> รายการ</p>
          <button id="addPfBtn" class="bg-terracotta text-cream px-4 py-2 rounded-md text-sm font-medium hover:bg-terracotta/90 transition-colors">
            + เพิ่มผลงานใหม่
          </button>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-[#f5f3f0]">
              <tr>
                <th class="text-left px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">ชื่อ</th>
                <th class="text-left px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">Slug</th>
                <th class="text-center px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">สถานะ</th>
                <th class="text-center px-4 py-3 text-xs font-medium text-brown/60 uppercase tracking-wider">จัดการ</th>
              </tr>
            </thead>
            <tbody id="portfolioTable" class="divide-y divide-[#d4d0cb]">
              <tr><td colspan="4" class="px-4 py-8 text-center text-brown/40">กำลังโหลด...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- PRODUCT MODAL -->
  <div id="modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-[#d4d0cb] px-6 py-4 flex items-center justify-between">
        <h2 id="modalTitle" class="text-lg font-serif">เพิ่มสินค้าใหม่</h2>
        <button id="closeModal" class="text-brown/60 hover:text-brown text-2xl leading-none">&times;</button>
      </div>
      <form id="productForm" class="p-6 space-y-4">
        <input type="hidden" name="id" id="productId" />
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">ชื่อ *</label>
            <input type="text" name="name" id="name" required class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">Slug</label>
            <input type="text" name="slug" id="slug" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">หมวดหมู่ *</label>
            <select name="category" id="category" required class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50">
              <option value="marble">หินอ่อน</option>
              <option value="granite">หินแกรนิต</option>
              <option value="artificial">หินเทียม</option>
              <option value="quartz">หินควอทซ์</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">English Name</label>
            <input type="text" name="en" id="en" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brown mb-2">รูปภาพ (URL)</label>
          <div class="flex gap-2">
            <input type="text" name="image" id="image" placeholder="/assets/products/marble/example.jpg" class="flex-1 px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
            <button type="button" onclick="openImageLibrary((url) => { document.getElementById('image').value = url; document.getElementById('imagePreview').classList.remove('hidden'); document.getElementById('previewImg').src = url; })" class="px-3 py-2 bg-sage/10 text-sage rounded-md hover:bg-sage/20 text-sm border border-sage/30">📁</button>
          </div>
          <div id="imagePreview" class="mt-2 hidden">
            <img id="previewImg" src="" alt="Preview" class="w-32 h-32 object-cover rounded-md border border-[#d4d0cb]" />
          </div>
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">แหล่งที่มา</label>
            <input type="text" name="origin" id="origin" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">งานสำเร็จ</label>
            <input type="text" name="finish" id="finish" value="Polish" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">การใช้งาน</label>
            <input type="text" name="usage" id="usage" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
        </div>

        <div class="flex items-center gap-4 pt-4 border-t border-[#d4d0cb]">
          <button type="submit" class="bg-terracotta text-cream px-6 py-2 rounded-md font-medium hover:bg-terracotta/90 transition-colors">บันทึก</button>
          <button type="button" id="cancelBtn" class="px-6 py-2 border border-[#d4d0cb] rounded-md font-medium hover:bg-brown/5 transition-colors">ยกเลิก</button>
        </div>
      </form>
    </div>
  </div>

  <!-- PORTFOLIO MODAL -->
  <div id="portfolioModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-[#d4d0cb] px-6 py-4 flex items-center justify-between">
        <h2 id="portfolioModalTitle" class="text-lg font-serif">เพิ่มผลงานใหม่</h2>
        <button id="closePortfolioModal" class="text-brown/60 hover:text-brown text-2xl leading-none">&times;</button>
      </div>
      <form id="portfolioForm" class="p-6 space-y-4">
        <input type="hidden" name="id" id="portfolioId" />
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">ชื่อ *</label>
            <input type="text" name="title" id="pfTitle" required class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">Slug</label>
            <input type="text" name="slug" id="pfSlug" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-2">ประเภท *</label>
            <select name="type" id="pfType" required class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50">
              <option value="stone">หินอ่อน/แกรนิต</option>
              <option value="factory">โรงงาน</option>
              <option value="office">อาคารสำนักงาน</option>
              <option value="home">บ้านเรือน</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-2">หมวดหมู่</label>
            <input type="text" name="category" id="pfCategory" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brown mb-2">รูปภาพหลัก (URL)</label>
          <div class="flex gap-2">
            <input type="text" name="image" id="pfImage" class="flex-1 px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" />
            <button type="button" onclick="openImageLibrary((url) => { document.getElementById('pfImage').value = url; document.getElementById('pfImagePreview').classList.remove('hidden'); document.getElementById('pfPreviewImg').src = url; })" class="px-3 py-2 bg-sage/10 text-sage rounded-md hover:bg-sage/20 text-sm border border-sage/30">📁</button>
          </div>
          <div id="pfImagePreview" class="mt-2 hidden">
            <img id="pfPreviewImg" src="" alt="Preview" class="w-32 h-32 object-cover rounded-md border border-[#d4d0cb]" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brown mb-2">รูปภาพเพิ่มเติม (แต่ละบรรทัด = 1 URL)</label>
          <textarea name="images" id="pfImages" rows="3" class="flex-1 px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs"></textarea>
          <button type="button" onclick="openImageLibrary(addToPfImages)" class="px-3 py-2 bg-sage/10 text-sage rounded-md hover:bg-sage/20 text-sm border border-sage/30 self-start mt-1">📁</button>
          <div id="pfImagesPreview" class="mt-2 flex flex-wrap gap-2"></div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brown mb-2">รายละเอียด</label>
          <textarea name="description" id="pfDescription" rows="3" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50"></textarea>
        </div>

        <div class="flex items-center gap-4 pt-4 border-t border-[#d4d0cb]">
          <button type="submit" class="bg-terracotta text-cream px-6 py-2 rounded-md font-medium hover:bg-terracotta/90 transition-colors">บันทึก</button>
          <button type="button" id="cancelPortfolioBtn" class="px-6 py-2 border border-[#d4d0cb] rounded-md font-medium hover:bg-brown/5 transition-colors">ยกเลิก</button>
        </div>
      </form>
    </div>
  </div>

  <!-- DELETE MODAL -->
  <div id="deleteModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-md p-6 text-center">
      <h3 class="text-lg font-serif mb-4">ยืนยันการลบ?</h3>
      <p class="text-brown/60 mb-6" id="deleteName"></p>
      <div class="flex gap-4 justify-center">
        <button id="confirmDelete" class="bg-red-500 text-white px-6 py-2 rounded-md font-medium hover:bg-red-600 transition-colors">ลบ</button>
        <button id="cancelDelete" class="px-6 py-2 border border-[#d4d0cb] rounded-md font-medium hover:bg-brown/5 transition-colors">ยกเลิก</button>
      </div>
    </div>
  </div>

  <!-- PORTFOLIO DELETE MODAL -->
  <div id="deletePfModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-6">
    <div class="bg-white rounded-lg w-full max-w-md p-6 text-center">
      <h3 class="text-lg font-serif mb-4">ยืนยันการลบผลงาน?</h3>
      <p class="text-brown/60 mb-6" id="deletePfName"></p>
      <div class="flex gap-4 justify-center">
        <button id="confirmPfDelete" class="bg-red-500 text-white px-6 py-2 rounded-md font-medium hover:bg-red-600 transition-colors">ลบ</button>
        <button id="cancelPfDelete" class="px-6 py-2 border border-[#d4d0cb] rounded-md font-medium hover:bg-brown/5 transition-colors">ยกเลิก</button>
      </div>
    </div>
  </div>

  <!-- DEBUG CONSOLE -->
  <div id="debugConsole" style="position:fixed;bottom:0;left:0;right:0;max-height:200px;overflow-y:auto;background:#1a1a1a;color:#0f0;padding:12px;font-family:monospace;font-size:12px;z-index:9999;display:none;">
    <div style="margin-bottom:4px;font-weight:bold;color:#ff0;">DEBUG LOG:</div>
    <div id="debugLog"></div>
  </div>
  <button onclick="toggleDebug()" style="position:fixed;bottom:10px;right:10px;background:#333;color:#0f0;padding:8px 12px;border:none;border-radius:4px;cursor:pointer;z-index:9998;font-size:11px;">🐛 Debug</button>

  <script is:inline>
    // ============== DEBUG SYSTEM ==============
    let debugVisible = false;
    const logs = [];
    function toggleDebug() {
      debugVisible = !debugVisible;
      document.getElementById('debugConsole').style.display = debugVisible ? 'block' : 'none';
    }
    function debug(msg, data) {
      const time = new Date().toLocaleTimeString();
      const logLine = '[' + time + '] ' + msg + (data !== undefined ? ' ' + JSON.stringify(data) : '');
      logs.push(logLine);
      if (logs.length > 100) logs.shift();
      const el = document.getElementById('debugLog');
      el.innerHTML = logs.map(l => '<div style="margin-bottom:2px;">' + l.replace(/</g, '&lt;') + '</div>').join('');
      el.scrollTop = el.scrollHeight;
      console.log('[DEBUG]', msg, data);
    }
    
    debug('=== ADMIN PAGE LOADING ===');

    // ============== STATE ==============
    let products = [];
    let portfolio = [];
    let currentCategory = 'marble';
    let currentPfCategory = 'stone';
    let deleteTargetId = null;
    let deletePfTargetId = null;

    // ============== DOM ELEMENTS ==============
    const modal = document.getElementById('modal');
    const portfolioModal = document.getElementById('portfolioModal');
    const deleteModal = document.getElementById('deleteModal');
    const deletePfModal = document.getElementById('deletePfModal');
    const productForm = document.getElementById('productForm');
    const portfolioForm = document.getElementById('portfolioForm');
    const productTable = document.getElementById('productTable');
    const portfolioTable = document.getElementById('portfolioTable');

    debug('DOM elements loaded', {
      modal: !!modal,
      productTable: !!productTable,
      portfolioTable: !!portfolioTable
    });

    // ============== MAIN TAB SWITCHING ==============
    document.querySelectorAll('.main-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        debug('Main tab clicked: ' + btn.dataset.main);
        document.querySelectorAll('.main-tab').forEach(b => {
          b.classList.remove('bg-terracotta', 'text-cream');
          b.classList.add('bg-white', 'text-brown', 'border', 'border-[#d4d0cb]');
        });
        btn.classList.add('bg-terracotta', 'text-cream');
        btn.classList.remove('bg-white', 'text-brown', 'border', 'border-[#d4d0cb]');
        
        const main = btn.dataset.main;
        if (main === 'products') {
          document.getElementById('productsSection').classList.remove('hidden');
          document.getElementById('portfolioSection').classList.add('hidden');
          debug('Switched to PRODUCTS');
        } else if (main === 'portfolio') {
          document.getElementById('productsSection').classList.add('hidden');
          document.getElementById('portfolioSection').classList.remove('hidden');
          debug('Switching to PORTFOLIO, calling loadPortfolio...');
          loadPortfolio();
        }
      });
    });

    // ============== LOAD PRODUCTS ==============
    async function loadProducts() {
      debug('>>> loadProducts() CALLED');
      try {
        const res = await fetch('/api/admin/products', { credentials: 'include' });
        debug('Response status: ' + res.status);
        
        if (res.status === 401) {
          debug('UNAUTHORIZED - redirecting to login');
          window.location.href = '/admin/login';
          return;
        }
        
        const data = await res.json();
        debug('Products received: ' + data.length + ' items');
        
        products = data;
        updateStats();
        renderTable();
      } catch (err) {
        debug('ERROR in loadProducts: ' + err.message);
      }
    }

    // ============== UPDATE STATS ==============
    function updateStats() {
      const marble = products.filter(p => p.category === 'marble').length;
      const granite = products.filter(p => p.category === 'granite').length;
      const artificial = products.filter(p => p.category === 'artificial').length;
      const quartz = products.filter(p => p.category === 'quartz').length;
      
      document.getElementById('count-marble').textContent = marble;
      document.getElementById('count-granite').textContent = granite;
      document.getElementById('count-artificial').textContent = artificial;
      document.getElementById('count-quartz').textContent = quartz;
      
      debug('Stats: marble=' + marble + ', granite=' + granite + ', artificial=' + artificial + ', quartz=' + quartz);
    }

    // ============== RENDER TABLE ==============
    function renderTable() {
      debug('>>> renderTable() CALLED, category=' + currentCategory);
      const filtered = products.filter(p => p.category === currentCategory);
      document.getElementById('totalCount').textContent = filtered.length;
      
      if (filtered.length === 0) {
        productTable.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-brown/40">ไม่มีสินค้าในหมวดนี้</td></tr>';
        return;
      }

      productTable.innerHTML = filtered.map(p => {
        const img = p.image || '';
        const imgHtml = img 
          ? '<img src="' + img + '" class="w-10 h-10 object-cover rounded bg-[#d4d0cb]" onerror="this.style.display=\'none\'" />' 
          : '<div class="w-10 h-10 rounded bg-[#d4d0cb]"></div>';
        return '<tr class="hover:bg-[#f5f3f0]/50">' +
          '<td class="px-4 py-3"><div class="flex items-center gap-3">' + imgHtml + '<div><p class="font-medium">' + (p.name || '') + '</p><p class="text-xs text-brown/50">' + (p.en || '-') + '</p></div></div></td>' +
          '<td class="px-4 py-3 text-sm text-brown/60 font-mono">' + (p.slug || '') + '</td>' +
          '<td class="px-4 py-3 text-center"><button data-id="' + p.id + '" data-active="' + p.active + '" class="toggle-btn px-3 py-1 rounded-full text-xs font-medium ' + (p.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700') + '">' + (p.active ? 'เปิดใช้งาน' : 'ปิดใช้งาน') + '</button></td>' +
          '<td class="px-4 py-3 text-center"><button data-id="' + p.id + '" class="clone-btn text-sm text-blue-500 hover:underline mr-3">คัดลอก</button><button data-id="' + p.id + '" class="edit-btn text-sm text-sage hover:underline mr-3">แก้ไข</button><button data-id="' + p.id + '" data-name="' + (p.name || '') + '" class="delete-btn text-sm text-red-500 hover:underline">ลบ</button></td>' +
        '</tr>';
      }).join('');

      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => toggleActive(btn.dataset.id, btn.dataset.active === 'true'));
      });
      document.querySelectorAll('.clone-btn').forEach(btn => {
        btn.addEventListener('click', () => cloneProduct(btn.dataset.id));
      });
      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', () => editProduct(btn.dataset.id));
      });
      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', () => showDeleteConfirm(btn.dataset.id, btn.dataset.name));
      });
      debug('Table rendered: ' + filtered.length + ' rows');
    }

    // ============== PRODUCT TAB SWITCHING ==============
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('border-sage', 'text-sage');
          b.classList.add('border-transparent', 'text-brown/60');
        });
        btn.classList.add('border-sage', 'text-sage');
        btn.classList.remove('border-transparent', 'text-brown/60');
        currentCategory = btn.dataset.tab;
        document.getElementById('category').value = currentCategory;
        renderTable();
      });
    });

    // ============== ADD PRODUCT ==============
    document.getElementById('addBtn').addEventListener('click', () => {
      document.getElementById('modalTitle').textContent = 'เพิ่มสินค้าใหม่';
      document.getElementById('productId').value = '';
      productForm.reset();
      document.getElementById('category').value = currentCategory;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });

    // ============== CLONE, EDIT, TOGGLE, DELETE ==============
    function cloneProduct(id) {
      const p = products.find(pr => pr.id === id);
      if (!p) return;
      const newSlug = p.slug + '-copy-' + Date.now().toString(36);
      const clonedData = { ...p, id: undefined, slug: newSlug, name: p.name + ' (คัดลอก)', en: p.en ? p.en + ' (copy)' : '', active: false, sort: p.sort + 1 };
      fetch('/api/admin/products', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(clonedData), credentials: 'include' })
        .then(res => { if (res.ok) loadProducts(); });
    }

    function editProduct(id) {
      const p = products.find(pr => pr.id === id);
      if (!p) return;
      document.getElementById('modalTitle').textContent = 'แก้ไขสินค้า';
      document.getElementById('productId').value = p.id || '';
      document.getElementById('name').value = p.name || '';
      document.getElementById('slug').value = p.slug || '';
      document.getElementById('category').value = p.category || currentCategory;
      document.getElementById('en').value = p.en || '';
      document.getElementById('image').value = p.image || '';
      document.getElementById('origin').value = p.origin || '';
      document.getElementById('finish').value = p.finish || 'Polish';
      document.getElementById('usage').value = p.usage || '';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    async function toggleActive(id, currentActive) {
      try {
        const res = await fetch('/api/admin/products', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, active: !currentActive }), credentials: 'include' });
        if (res.ok) loadProducts();
      } catch (err) { debug('ERROR toggleActive: ' + err.message); }
    }

    function showDeleteConfirm(id, name) {
      deleteTargetId = id;
      document.getElementById('deleteName').textContent = 'ลบ "' + name + '" ?';
      deleteModal.classList.remove('hidden');
      deleteModal.classList.add('flex');
    }

    document.getElementById('confirmDelete').addEventListener('click', async () => {
      if (!deleteTargetId) return;
      try {
        const res = await fetch('/api/admin/products?id=' + deleteTargetId, { method: 'DELETE', credentials: 'include' });
        if (res.ok) { deleteModal.classList.add('hidden'); deleteModal.classList.remove('flex'); loadProducts(); }
      } catch (err) { debug('ERROR delete: ' + err.message); }
    });

    document.getElementById('cancelDelete').addEventListener('click', () => {
      deleteModal.classList.add('hidden');
      deleteModal.classList.remove('flex');
    });

    // ============== PRODUCT FORM SUBMIT ==============
    productForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      const isEdit = !!data.id;
      const method = isEdit ? 'PUT' : 'POST';
      try {
        const res = await fetch('/api/admin/products', { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data), credentials: 'include' });
        if (res.ok) { modal.classList.add('hidden'); modal.classList.remove('flex'); loadProducts(); }
      } catch (err) { debug('ERROR form submit: ' + err.message); }
    });

    // ============== IMAGE PREVIEW ==============
    document.getElementById('image').addEventListener('input', (e) => {
      const src = e.target.value.trim();
      const preview = document.getElementById('imagePreview');
      const img = document.getElementById('previewImg');
      if (src) { img.src = src; preview.classList.remove('hidden'); img.onerror = () => { img.src = '/assets/placeholder.jpg'; }; }
      else { preview.classList.add('hidden'); }
    });

    // ============== CLOSE MODAL ==============
    document.getElementById('closeModal').addEventListener('click', () => { modal.classList.add('hidden'); modal.classList.remove('flex'); });
    document.getElementById('cancelBtn').addEventListener('click', () => { modal.classList.add('hidden'); modal.classList.remove('flex'); });

    // ============== LOAD PORTFOLIO ==============
    async function loadPortfolio() {
      debug('>>> loadPortfolio() CALLED');
      try {
        const res = await fetch('/api/admin/portfolio', { credentials: 'include' });
        debug('Portfolio response: ' + res.status);
        
        if (res.status === 401) {
          window.location.href = '/admin/login';
          return;
        }
        
        const data = await res.json();
        debug('Portfolio received: ' + data.length + ' items');
        
        portfolio = data;
        updatePfStats();
        renderPfTable();
      } catch (err) {
        debug('ERROR in loadPortfolio: ' + err.message);
      }
    }

    // ============== UPDATE PF STATS ==============
    function updatePfStats() {
      const stone = portfolio.filter(p => p.type === 'stone').length;
      const factory = portfolio.filter(p => p.type === 'factory').length;
      const office = portfolio.filter(p => p.type === 'office').length;
      const home = portfolio.filter(p => p.type === 'home').length;
      
      document.getElementById('pf-count-stone').textContent = stone;
      document.getElementById('pf-count-factory').textContent = factory;
      document.getElementById('pf-count-office').textContent = office;
      document.getElementById('pf-count-home').textContent = home;
    }

    // ============== RENDER PF TABLE ==============
    function renderPfTable() {
      debug('>>> renderPfTable() CALLED, type=' + currentPfCategory);
      const filtered = portfolio.filter(p => p.type === currentPfCategory);
      document.getElementById('pf-totalCount').textContent = filtered.length;
      
      if (filtered.length === 0) {
        portfolioTable.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-brown/40">ไม่มีผลงานในหมวดนี้</td></tr>';
        return;
      }

      portfolioTable.innerHTML = filtered.map(p => {
        const img = p.image || '';
        const imgHtml = img 
          ? '<img src="' + img + '" class="w-10 h-10 object-cover rounded bg-[#d4d0cb]" onerror="this.style.display=\'none\'" />' 
          : '<div class="w-10 h-10 rounded bg-[#d4d0cb]"></div>';
        return '<tr class="hover:bg-[#f5f3f0]/50">' +
          '<td class="px-4 py-3"><div class="flex items-center gap-3">' + imgHtml + '<div><p class="font-medium">' + (p.title || '') + '</p><p class="text-xs text-brown/50">' + (p.category || '-') + '</p></div></div></td>' +
          '<td class="px-4 py-3 text-sm text-brown/60 font-mono">' + (p.slug || '') + '</td>' +
          '<td class="px-4 py-3 text-center"><button data-id="' + p.id + '" data-active="' + p.active + '" class="pf-toggle-btn px-3 py-1 rounded-full text-xs font-medium ' + (p.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700') + '">' + (p.active ? 'เปิดใช้งาน' : 'ปิดใช้งาน') + '</button></td>' +
          '<td class="px-4 py-3 text-center"><button data-id="' + p.id + '" class="pf-clone-btn text-sm text-blue-500 hover:underline mr-3">คัดลอก</button><button data-id="' + p.id + '" class="pf-edit-btn text-sm text-sage hover:underline mr-3">แก้ไข</button><button data-id="' + p.id + '" data-title="' + (p.title || '') + '" class="pf-delete-btn text-sm text-red-500 hover:underline">ลบ</button></td>' +
        '</tr>';
      }).join('');

      document.querySelectorAll('.pf-toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => togglePfActive(btn.dataset.id, btn.dataset.active === 'true'));
      });
      document.querySelectorAll('.pf-clone-btn').forEach(btn => {
        btn.addEventListener('click', () => clonePortfolio(btn.dataset.id));
      });
      document.querySelectorAll('.pf-edit-btn').forEach(btn => {
        btn.addEventListener('click', () => editPortfolio(btn.dataset.id));
      });
      document.querySelectorAll('.pf-delete-btn').forEach(btn => {
        btn.addEventListener('click', () => showPfDeleteConfirm(btn.dataset.id, btn.dataset.title));
      });
      debug('PF Table rendered: ' + filtered.length + ' rows');
    }

    // ============== PORTFOLIO TAB SWITCHING ==============
    document.querySelectorAll('.pf-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.pf-tab-btn').forEach(b => {
          b.classList.remove('border-sage', 'text-sage');
          b.classList.add('border-transparent', 'text-brown/60');
        });
        btn.classList.add('border-sage', 'text-sage');
        btn.classList.remove('border-transparent', 'text-brown/60');
        currentPfCategory = btn.dataset.pfTab;
        document.getElementById('pfType').value = currentPfCategory;
        renderPfTable();
      });
    });

    // ============== ADD PORTFOLIO ==============
    document.getElementById('addPfBtn').addEventListener('click', () => {
      document.getElementById('portfolioModalTitle').textContent = 'เพิ่มผลงานใหม่';
      document.getElementById('portfolioId').value = '';
      portfolioForm.reset();
      document.getElementById('pfType').value = currentPfCategory;
      portfolioModal.classList.remove('hidden');
      portfolioModal.classList.add('flex');
    });

    function clonePortfolio(id) {
      const p = portfolio.find(pr => pr.id === id);
      if (!p) return;
      const newSlug = p.slug + '-copy-' + Date.now().toString(36);
      const clonedData = { ...p, id: undefined, slug: newSlug, title: p.title + ' (คัดลอก)', active: false, sort: p.sort + 1 };
      fetch('/api/admin/portfolio', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(clonedData), credentials: 'include' })
        .then(res => { if (res.ok) loadPortfolio(); });
    }

    function editPortfolio(id) {
      const p = portfolio.find(pr => pr.id === id);
      if (!p) return;
      document.getElementById('portfolioModalTitle').textContent = 'แก้ไขผลงาน';
      document.getElementById('portfolioId').value = p.id;
      document.getElementById('pfTitle').value = p.title || '';
      document.getElementById('pfSlug').value = p.slug || '';
      document.getElementById('pfType').value = p.type;
      document.getElementById('pfCategory').value = p.category || '';
      document.getElementById('pfImage').value = p.image || '';
      document.getElementById('pfImages').value = (p.images || []).join('\n');
      document.getElementById('pfDescription').value = p.description || '';
      portfolioModal.classList.remove('hidden');
      portfolioModal.classList.add('flex');
    }

    async function togglePfActive(id, currentActive) {
      try {
        const res = await fetch('/api/admin/portfolio', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, active: !currentActive }), credentials: 'include' });
        if (res.ok) loadPortfolio();
      } catch (err) { debug('ERROR togglePfActive: ' + err.message); }
    }

    function showPfDeleteConfirm(id, title) {
      deletePfTargetId = id;
      document.getElementById('deletePfName').textContent = 'ลบ "' + title + '" ?';
      deletePfModal.classList.remove('hidden');
      deletePfModal.classList.add('flex');
    }

    document.getElementById('confirmPfDelete').addEventListener('click', async () => {
      if (!deletePfTargetId) return;
      try {
        const res = await fetch('/api/admin/portfolio?id=' + deletePfTargetId, { method: 'DELETE', credentials: 'include' });
        if (res.ok) { deletePfModal.classList.add('hidden'); deletePfModal.classList.remove('flex'); loadPortfolio(); }
      } catch (err) { debug('ERROR PF delete: ' + err.message); }
    });

    document.getElementById('cancelPfDelete').addEventListener('click', () => {
      deletePfModal.classList.add('hidden');
      deletePfModal.classList.remove('flex');
    });

    // ============== PORTFOLIO FORM SUBMIT ==============
    portfolioForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      const pfImagesVal = document.getElementById('pfImages').value.trim();
      data.images = pfImagesVal ? pfImagesVal.split('\n').map(s => s.trim()).filter(Boolean) : [];
      const isEdit = !!data.id;
      const method = isEdit ? 'PUT' : 'POST';
      try {
        const res = await fetch('/api/admin/portfolio', { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data), credentials: 'include' });
        if (res.ok) { portfolioModal.classList.add('hidden'); portfolioModal.classList.remove('flex'); loadPortfolio(); }
      } catch (err) { debug('ERROR PF submit: ' + err.message); }
    });

    // ============== PF IMAGE PREVIEW ==============
    document.getElementById('pfImage').addEventListener('input', (e) => {
      const src = e.target.value.trim();
      const preview = document.getElementById('pfImagePreview');
      const img = document.getElementById('pfPreviewImg');
      if (src) { img.src = src; preview.classList.remove('hidden'); img.onerror = () => { img.src = '/assets/placeholder.jpg'; }; }
      else { preview.classList.add('hidden'); }
    });

    // ============== CLOSE PF MODAL ==============
    document.getElementById('closePortfolioModal').addEventListener('click', () => { portfolioModal.classList.add('hidden'); portfolioModal.classList.remove('flex'); });
    document.getElementById('cancelPortfolioBtn').addEventListener('click', () => { portfolioModal.classList.add('hidden'); portfolioModal.classList.remove('flex'); });

    // ============== LOGOUT ==============
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      debug('>>> LOGOUT CLICKED');
      try {
        const res = await fetch('/api/admin/logout', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Origin': window.location.origin }
        });
        debug('Logout response: ' + res.status);
        window.location.href = '/admin/login';
      } catch (err) {
        debug('ERROR logout: ' + err.message);
      }
    });

    // ============== IMAGE LIBRARY HELPERS ==============
    function addToPfImages(url) {
      var ta = document.getElementById('pfImages');
      if (ta.value) {
        ta.value += '\n' + url;
      } else {
        ta.value = url;
      }
      console.log('[DEBUG] Added to pfImages:', url);
    }

    // ============== INIT ==============
    debug('Calling loadProducts()...');
    loadProducts();
    debug('=== PAGE LOAD COMPLETE ===');
  </script>
</AdminLayout>
