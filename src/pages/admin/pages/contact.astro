---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { SESSION_COOKIE } from '../../../middleware/auth';

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<Layout title="ติดต่อ | Admin ไวยศิลา">
  <div class="min-h-screen bg-[#e0dcd7]">
    <header class="bg-white border-b border-[#d4d0cb] sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/admin/pages" class="text-sm text-brown/60 hover:text-sage">← หน้าเพจ</a>
          <span class="text-brown/30">|</span>
          <h1 class="text-xl font-serif">📞 ติดต่อ</h1>
        </div>
        <a href="/contact" target="_blank" class="text-sm text-brown/60 hover:text-sage">ดูเว็บไซต์ →</a>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-6 py-8">
      <div class="bg-white rounded-md border border-[#d4d0cb] p-6">
        <input type="hidden" id="pageId" />
        <input type="hidden" id="pageKey" value="contact" />

        <div class="flex items-center gap-6 mb-6 pb-4 border-b border-[#d4d0cb]">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="pageActive" class="w-5 h-5 accent-sage" />
            <span class="text-sm font-medium text-brown">เปิดใช้งานหน้านี้</span>
          </label>
          <a href="/contact" target="_blank" class="text-sm text-sage hover:underline ml-auto">ดูหน้าเพจ →</a>
        </div>

        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">📱 ช่องทางติดต่อ (Social)</h3>
        <div class="mb-6 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">โทรศัพท์</label>
              <input type="text" id="socialPhone" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="098-xxx-xxxx" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Line ID</label>
              <input type="text" id="socialLine" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="@waisira" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Facebook URL</label>
            <input type="text" id="socialFacebook" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="https://www.facebook.com/..." />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Instagram URL</label>
            <input type="text" id="socialInstagram" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="https://www.instagram.com/..." />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Line QR Code URL</label>
            <input type="text" id="socialLineQR" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-sm" placeholder="/assets/line-qr.png" />
          </div>
        </div>

        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">📋 ข้อมูลทั่วไป</h3>
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">สี/สไตล์</label>
              <input type="text" id="pageColorStyle" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="เข้าถึงง่าย, เป็นมิตร" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">ข้อมูล/รายละเอียด</label>
            <textarea id="pageInformation" rows="3" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="รายละเอียดเพิ่มเติม..."></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">ติดต่อ (ข้อความหลัก)</label>
            <input type="text" id="pageContact" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="098-xxx-xxxx, Line: @xxx" />
          </div>
        </div>

        <div class="flex gap-4 pt-6 mt-6 border-t border-[#d4d0cb]">
          <button id="saveBtn" class="bg-terracotta text-cream px-8 py-2 rounded-md font-medium hover:bg-terracotta/90 transition-colors">💾 บันทึก</button>
          <div id="saveStatus" class="hidden py-2 text-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function loadPage() {
      try {
        const res = await fetch('/api/admin/pages', { credentials: 'include' });
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        const pages = await res.json();
        const p = pages.find((pg: any) => pg.key === 'contact');
        if (!p) { document.body.innerHTML = '<p class="p-8 text-center text-red-500">ไม่พบข้อมูลหน้าติดต่อ</p>'; return; }
        document.getElementById('pageId').value = p.id || '';
        document.getElementById('pageActive').checked = p.active !== false;
        document.getElementById('pageColorStyle').value = p.colorStyle || '';
        document.getElementById('pageInformation').value = p.information || '';
        document.getElementById('pageContact').value = p.contact || '';
        const social = p.social || {};
        document.getElementById('socialPhone').value = social.phone || '';
        document.getElementById('socialLine').value = social.line || '';
        document.getElementById('socialFacebook').value = social.facebook || '';
        document.getElementById('socialInstagram').value = social.instagram || '';
        document.getElementById('socialLineQR').value = social.lineQR || '';
      } catch (err) { console.error(err); }
    }

    document.getElementById('saveBtn').addEventListener('click', async () => {
      const btn = document.getElementById('saveBtn');
      const status = document.getElementById('saveStatus');
      btn.disabled = true; btn.textContent = 'กำลังบันทึก...';
      status.classList.add('hidden');

      const data = {
        id: document.getElementById('pageId').value,
        active: document.getElementById('pageActive').checked,
        colorStyle: document.getElementById('pageColorStyle').value,
        information: document.getElementById('pageInformation').value,
        contact: document.getElementById('pageContact').value,
        social: {
          phone: document.getElementById('socialPhone').value,
          line: document.getElementById('socialLine').value,
          facebook: document.getElementById('socialFacebook').value,
          instagram: document.getElementById('socialInstagram').value,
          lineQR: document.getElementById('socialLineQR').value,
        }
      };

      try {
        const res = await fetch('/api/admin/pages', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data), credentials: 'include' });
        if (res.ok) {
          status.textContent = '✅ บันทึกสำเร็จ!'; status.classList.remove('hidden', 'text-red-500'); status.classList.add('text-green-600');
          setTimeout(() => status.classList.add('hidden'), 3000);
          loadPage();
        } else {
          const err = await res.text();
          status.textContent = '❌ ผิดพลาด: ' + err; status.classList.remove('hidden', 'text-green-600'); status.classList.add('text-red-500');
        }
      } catch (err) {
        status.textContent = '❌ เกิดข้อผิดพลาด'; status.classList.remove('hidden'); status.classList.add('text-red-500');
      }
      btn.disabled = false; btn.textContent = '💾 บันทึก';
    });

    loadPage();
  </script>
</Layout>
