---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { SESSION_COOKIE } from '../../../middleware/auth';

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="หน้าแรก | Admin ไวยศิลา">
  <div class="min-h-screen bg-[#e0dcd7]">
    <header class="bg-white border-b border-[#d4d0cb] sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/admin/pages" class="text-sm text-brown/60 hover:text-sage">← หน้าเพจ</a>
          <span class="text-brown/30">|</span>
          <h1 class="text-xl font-serif">🏠 หน้าแรก</h1>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" target="_blank" class="text-sm text-brown/60 hover:text-sage">ดูเว็บไซต์ →</a>
        </div>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-6 py-8">
      <div class="bg-white rounded-md border border-[#d4d0cb] p-6">
        <input type="hidden" id="pageId" />
        <input type="hidden" id="pageKey" value="homepage" />

        <!-- Active toggle -->
        <div class="flex items-center gap-6 mb-6 pb-4 border-b border-[#d4d0cb]">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="pageActive" class="w-5 h-5 accent-sage" />
            <span class="text-sm font-medium text-brown">เปิดใช้งานหน้านี้</span>
          </label>
          <a href="/" target="_blank" class="text-sm text-sage hover:underline ml-auto">ดูหน้าเพจ →</a>
        </div>

        <!-- Hero Section -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">🖼️ Hero Section</h3>
        <div class="space-y-4 mb-6">
          <div>
            <label class="block text-sm font-medium text-brown mb-1">รูปภาพ Hero (หลายรูป ขั้นด้วย comma)</label>
            <div class="flex gap-2">
              <textarea id="pageImages" rows="3" class="flex-1 px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs" placeholder="/assets/img1.jpg, /assets/img2.jpg"></textarea>
              <button type="button" onclick="openImageLibrary((url) => { const ta = document.getElementById('pageImages'); ta.value = ta.value ? ta.value + ', ' + url : url; })" class="px-3 py-2 bg-sage/10 text-sage rounded-md hover:bg-sage/20 text-sm border border-sage/30">📁 เลือกรูป</button>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Hero แท็กไลน์</label>
            <input type="text" id="pageHeroTagline" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="เช่น สุดหรู สุดประณีต สำหรับคนพิเศษ" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Hero หัวข้อ (pipe-separated)</label>
              <input type="text" id="pageHeroTitle" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="งานหินอ่อน|หินแกรนิต|ระดับพรีเมียม" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Hero สี (comma-separated)</label>
              <input type="text" id="pageHeroTitleColors" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="white,cream,cream/80,cream/60,cream" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Hero คำอธิบาย</label>
            <textarea id="pageHeroInfo" rows="2" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ข้อความใต้หัวข้อ Hero"></textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">ปุ่ม CTA</label>
              <input type="text" id="pageHeroCTA" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="นัดประเมินราคาฟรี" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">ลิงก์ปุ่ม CTA</label>
              <input type="text" id="pageHeroCTAUrl" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="/contact" />
            </div>
          </div>
        </div>

        <!-- Trust Badges -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">⭐ Trust Badges</h3>
        <div class="mb-6">
          <label class="block text-sm font-medium text-brown mb-1">Trust Badges (JSON array)</label>
          <textarea id="pageTrustBadges" rows="3" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs" placeholder='["รับประกันงาน", "ส่งมอบตรงเวลา", "วัสดุเกรด A"]'></textarea>
          <p class="text-xs text-brown/40 mt-1">ใส่ JSON array ของข้อความ badge</p>
        </div>

        <!-- About/Story Section -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">📖 เรื่องราว / About Section</h3>
        <div class="space-y-4 mb-6">
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Section Heading</label>
            <input type="text" id="pageStoryHeading" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ผู้เชี่ยวชาญด้านหินธรรมชาติ" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Section Subheading</label>
            <input type="text" id="pageStorySubheading" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="เรื่องราวของเรา" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">About Paragraph</label>
            <textarea id="pageAboutText" rows="4" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="รายละเอียดเกี่ยวกับบริษัท..."></textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Experience Badge Label</label>
              <input type="text" id="pageExperienceLabel" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ปีแห่งประสบการณ์" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Factory Image URL</label>
              <input type="text" id="pageFactoryImage" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-sm" placeholder="/assets/services/factory-interior.jpg" />
            </div>
          </div>
        </div>

        <!-- Products / Category Labels Section -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">🧱 หมวดสินค้า (หน้าแรก)</h3>
        <div class="space-y-4 mb-6">
          <div>
            <label class="block text-sm font-medium text-brown mb-1">หัวข้อ "หมวดสินค้า"</label>
            <input type="text" id="pageProductsLabel" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="หมวดสินค้า" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">หัวข้อ "สินค้าของเรา"</label>
            <input type="text" id="pageProductsHeading" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="สินค้าของเรา" />
          </div>
          <!-- Category 1 -->
          <div class="grid grid-cols-3 gap-4 p-4 bg-[#f5f3f0] rounded-md">
            <div class="col-span-3 mb-2"><strong>หินอ่อน (Marble)</strong></div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">ชื่อ TH</label>
              <input type="text" id="cat1Name" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm" placeholder="หินอ่อน" />
            </div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">ชื่อ EN</label>
              <input type="text" id="cat1En" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm" placeholder="Marble" />
            </div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">รูป</label>
              <input type="text" id="cat1Image" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm font-mono" placeholder="/assets/..." />
            </div>
          </div>
          <!-- Category 2 -->
          <div class="grid grid-cols-3 gap-4 p-4 bg-[#f5f3f0] rounded-md">
            <div class="col-span-3 mb-2"><strong>หินแกรนิต (Granite)</strong></div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">ชื่อ TH</label>
              <input type="text" id="cat2Name" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm" placeholder="หินแกรนิต" />
            </div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">ชื่อ EN</label>
              <input type="text" id="cat2En" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm" placeholder="Granite" />
            </div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">รูป</label>
              <input type="text" id="cat2Image" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm font-mono" placeholder="/assets/..." />
            </div>
          </div>
          <!-- Category 3 -->
          <div class="grid grid-cols-3 gap-4 p-4 bg-[#f5f3f0] rounded-md">
            <div class="col-span-3 mb-2"><strong>หินสังเคราะห์ (Artificial)</strong></div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">ชื่อ TH</label>
              <input type="text" id="cat3Name" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm" placeholder="หินสังเคราะห์" />
            </div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">ชื่อ EN</label>
              <input type="text" id="cat3En" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm" placeholder="Artificial" />
            </div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">รูป</label>
              <input type="text" id="cat3Image" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm font-mono" placeholder="/assets/..." />
            </div>
          </div>
          <!-- Category 4 -->
          <div class="grid grid-cols-3 gap-4 p-4 bg-[#f5f3f0] rounded-md">
            <div class="col-span-3 mb-2"><strong>หินควอทซ์ (Quartz)</strong></div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">ชื่อ TH</label>
              <input type="text" id="cat4Name" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm" placeholder="หินควอทซ์" />
            </div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">ชื่อ EN</label>
              <input type="text" id="cat4En" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm" placeholder="Quartz" />
            </div>
            <div>
              <label class="block text-xs font-medium text-brown mb-1">รูป</label>
              <input type="text" id="cat4Image" class="w-full px-3 py-1 border border-[#d4d0cb] rounded-md text-sm font-mono" placeholder="/assets/..." />
            </div>
          </div>
        </div>

        <!-- Testimonials & CTA Section -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">⭐ Testimonials & CTA</h3>
        <div class="space-y-4 mb-6">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Testimonial Section Label</label>
              <input type="text" id="pageTestimonialLabel" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="รีวิวจากลูกค้า" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Testimonial Section Heading</label>
              <input type="text" id="pageTestimonialHeading" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ลูกค้าของเราพูดอย่างไร" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">CTA Heading</label>
            <input type="text" id="pageCtaHeading" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="สนใจสินค้าหรือบริการ?" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">CTA Subtext</label>
            <input type="text" id="pageCtaSubtext" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ติดต่อเราได้ตลอดเวลา" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Services Fallback Text</label>
            <textarea id="pageServicesText" rows="2" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="บริการตัด เจาะ เจียร์..."></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Portfolio Section Label</label>
            <input type="text" id="pagePortfolioLabel" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ผลงาน" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Portfolio Section Heading</label>
            <input type="text" id="pagePortfolioHeading" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ผลงานติดตั้ง" />
          </div>
        </div>

        <!-- General Info -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">📋 ข้อมูลทั่วไป</h3>
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">สี/สไตล์</label>
              <input type="text" id="pageColorStyle" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="เช่น คลาสสิก, หรูหรา" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">ขนาด/ไซต์</label>
              <input type="text" id="pageSizeText" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="เช่น 60x60 ซม." />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">ข้อมูล/รายละเอียด</label>
            <textarea id="pageInformation" rows="3" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="รายละเอียดเพิ่มเติม..."></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">ติดต่อ</label>
            <input type="text" id="pageContact" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="099-xxx-xxxx" />
          </div>
        </div>

        <!-- Save -->
        <div class="flex gap-4 pt-6 mt-6 border-t border-[#d4d0cb]">
          <button id="saveBtn" class="bg-terracotta text-cream px-8 py-2 rounded-md font-medium hover:bg-terracotta/90 transition-colors">
            💾 บันทึก
          </button>
          <div id="saveStatus" class="hidden py-2 text-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let pageData = null;
    let settingsData = null;

    async function loadPage() {
      try {
        // Load page data
        const pagesRes = await fetch('/api/admin/pages', { credentials: 'include' });
        if (pagesRes.status === 401) { window.location.href = '/admin/login'; return; }
        const pages = await pagesRes.json();
        pageData = pages.find((p: any) => p.key === 'homepage');
        if (!pageData) { document.body.innerHTML = '<p class="p-8 text-center text-red-500">ไม่พบข้อมูลหน้าแรก</p>'; return; }
        
        // Load settings (for trustBadges)
        const settingsRes = await fetch('/api/admin/settings', { credentials: 'include' });
        if (settingsRes.ok) {
          settingsData = await settingsRes.json();
        }
        
        console.log('[DEBUG] Homepage loaded, page trustBadges:', pageData.trustBadges);
        console.log('[DEBUG] Settings trustBadges:', settingsData?.trustBadges);
        renderForm(pageData, settingsData);
      } catch (err) { console.error(err); }
    }

    function renderForm(p, settings) {
      document.getElementById('pageId').value = p.id || '';
      document.getElementById('pageActive').checked = p.active !== false;
      document.getElementById('pageImages').value = (p.images || []).join(', ');
      document.getElementById('pageHeroTagline').value = p.heroTagline || '';
      document.getElementById('pageHeroTitle').value = p.heroTitle || '';
      document.getElementById('pageHeroTitleColors').value = p.heroTitleColors || '';
      document.getElementById('pageHeroInfo').value = p.heroInfo || '';
      document.getElementById('pageHeroCTA').value = p.heroCTA || '';
      document.getElementById('pageHeroCTAUrl').value = p.heroCTAUrl || '/contact';
      
      // Use settings trustBadges (with text/icon objects) or fallback to page trustBadges
      const trustBadges = settings?.trustBadges || p.trustBadges || [];
      const trustBadgeValue = Array.isArray(trustBadges) ? JSON.stringify(trustBadges, null, 2) : '';
      console.log('[DEBUG] renderForm trustBadges:', trustBadgeValue);
      document.getElementById('pageTrustBadges').value = trustBadgeValue;
      
      document.getElementById('pageColorStyle').value = p.colorStyle || '';
      document.getElementById('pageSizeText').value = p.sizeText || '';
      document.getElementById('pageInformation').value = p.information || '';
      document.getElementById('pageContact').value = p.contact || '';
      
      // About/Story fields
      document.getElementById('pageStoryHeading').value = p.storyHeading || '';
      document.getElementById('pageStorySubheading').value = p.storySubheading || '';
      document.getElementById('pageAboutText').value = p.aboutText || '';
      document.getElementById('pageExperienceLabel').value = p.experienceLabel || '';
      document.getElementById('pageFactoryImage').value = p.factoryImage || '';

      // Products / Categories
      document.getElementById('pageProductsLabel').value = p.productsLabel || 'หมวดสินค้า';
      document.getElementById('pageProductsHeading').value = p.productsHeading || 'สินค้าของเรา';
      const cats = p.categories || [];
      document.getElementById('cat1Name').value = cats[0]?.name || 'หินอ่อน';
      document.getElementById('cat1En').value = cats[0]?.en || 'Marble';
      document.getElementById('cat1Image').value = cats[0]?.image || '';
      document.getElementById('cat2Name').value = cats[1]?.name || 'หินแกรนิต';
      document.getElementById('cat2En').value = cats[1]?.en || 'Granite';
      document.getElementById('cat2Image').value = cats[1]?.image || '';
      document.getElementById('cat3Name').value = cats[2]?.name || 'หินสังเคราะห์';
      document.getElementById('cat3En').value = cats[2]?.en || 'Artificial';
      document.getElementById('cat3Image').value = cats[2]?.image || '';
      document.getElementById('cat4Name').value = cats[3]?.name || 'หินควอทซ์';
      document.getElementById('cat4En').value = cats[3]?.en || 'Quartz';
      document.getElementById('cat4Image').value = cats[3]?.image || '';

      // Testimonials & CTA
      document.getElementById('pageTestimonialLabel').value = p.testimonialLabel || 'รีวิวจากลูกค้า';
      document.getElementById('pageTestimonialHeading').value = p.testimonialHeading || 'ลูกค้าของเราพูดอย่างไร';
      document.getElementById('pageCtaHeading').value = p.ctaHeading || 'สนใจสินค้าหรือบริการ?';
      document.getElementById('pageCtaSubtext').value = p.ctaSubtext || '';
      document.getElementById('pageServicesText').value = p.servicesText || '';
      document.getElementById('pagePortfolioLabel').value = p.portfolioLabel || 'ผลงาน';
      document.getElementById('pagePortfolioHeading').value = p.portfolioHeading || 'ผลงานติดตั้ง';
    }

    document.getElementById('saveBtn').addEventListener('click', async () => {
      const btn = document.getElementById('saveBtn');
      const status = document.getElementById('saveStatus');
      btn.disabled = true;
      btn.textContent = 'กำลังบันทึก...';
      status.classList.add('hidden');

      const images = document.getElementById('pageImages').value.split(',').map((s: string) => s.trim()).filter(Boolean);
      const data: any = {
        id: document.getElementById('pageId').value,
        active: document.getElementById('pageActive').checked,
        images,
        heroTagline: document.getElementById('pageHeroTagline').value,
        heroTitle: document.getElementById('pageHeroTitle').value,
        heroTitleColors: document.getElementById('pageHeroTitleColors').value,
        heroInfo: document.getElementById('pageHeroInfo').value,
        heroCTA: document.getElementById('pageHeroCTA').value,
        heroCTAUrl: document.getElementById('pageHeroCTAUrl').value,
        colorStyle: document.getElementById('pageColorStyle').value,
        sizeText: document.getElementById('pageSizeText').value,
        information: document.getElementById('pageInformation').value,
        contact: document.getElementById('pageContact').value,
        storyHeading: document.getElementById('pageStoryHeading').value,
        storySubheading: document.getElementById('pageStorySubheading').value,
        aboutText: document.getElementById('pageAboutText').value,
        experienceLabel: document.getElementById('pageExperienceLabel').value,
        factoryImage: document.getElementById('pageFactoryImage').value,
        productsLabel: document.getElementById('pageProductsLabel').value,
        productsHeading: document.getElementById('pageProductsHeading').value,
        categories: [
          { name: document.getElementById('cat1Name').value, en: document.getElementById('cat1En').value, image: document.getElementById('cat1Image').value },
          { name: document.getElementById('cat2Name').value, en: document.getElementById('cat2En').value, image: document.getElementById('cat2Image').value },
          { name: document.getElementById('cat3Name').value, en: document.getElementById('cat3En').value, image: document.getElementById('cat3Image').value },
          { name: document.getElementById('cat4Name').value, en: document.getElementById('cat4En').value, image: document.getElementById('cat4Image').value },
        ],
        testimonialLabel: document.getElementById('pageTestimonialLabel').value,
        testimonialHeading: document.getElementById('pageTestimonialHeading').value,
        ctaHeading: document.getElementById('pageCtaHeading').value,
        ctaSubtext: document.getElementById('pageCtaSubtext').value,
        servicesText: document.getElementById('pageServicesText').value,
        portfolioLabel: document.getElementById('pagePortfolioLabel').value,
        portfolioHeading: document.getElementById('pagePortfolioHeading').value,
      };

      // Parse trustBadges and save to settings.json
      const tbRaw = document.getElementById('pageTrustBadges').value.trim();
      console.log('[DEBUG] Save - tbRaw:', tbRaw);
      if (tbRaw) {
        try {
          const parsedBadges = JSON.parse(tbRaw);
          // Save trustBadges to settings.json
          const settingsRes = await fetch('/api/admin/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ trustBadges: parsedBadges }),
            credentials: 'include'
          });
          console.log('[DEBUG] Settings save response:', settingsRes.status);
        }
        catch (e) { alert('รูปแบบ Trust Badges JSON ไม่ถูกต้อง'); btn.disabled = false; btn.textContent = '💾 บันทึก'; return; }
      }

      try {
        const res = await fetch('/api/admin/pages', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });
        if (res.ok) {
          status.textContent = '✅ บันทึกสำเร็จ!';
          status.classList.remove('hidden', 'text-red-500');
          status.classList.add('text-green-600');
          setTimeout(() => status.classList.add('hidden'), 3000);
          loadPage();
        } else {
          const err = await res.text();
          status.textContent = '❌ ผิดพลาด: ' + err;
          status.classList.remove('hidden', 'text-green-600');
          status.classList.add('text-red-500');
        }
      } catch (err) {
        status.textContent = '❌ เกิดข้อผิดพลาด';
        status.classList.remove('hidden');
        status.classList.add('text-red-500');
      }
      btn.disabled = false;
      btn.textContent = '💾 บันทึก';
    });

    loadPage();
  </script>
</AdminLayout>
