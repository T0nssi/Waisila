---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSession } from '../../../middleware/auth';

if (!getSession(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="ตั้งค่า | Admin ไวยศิลา">
  <div class="min-h-screen bg-[#e0dcd7]">
    <header class="bg-white border-b border-[#d4d0cb] sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/admin/pages" class="text-sm text-brown/60 hover:text-sage">← หน้าเพจ</a>
          <span class="text-brown/30">|</span>
          <h1 class="text-xl font-serif">⚙️ ตั้งค่า</h1>
        </div>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-6 py-8">
      <div class="bg-white rounded-md border border-[#d4d0cb] p-6">
        
        <!-- Social / Contact Info -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">📞 ข้อมูลติดต่อ</h3>
        <div class="space-y-4 mb-6">
          <div>
            <label class="block text-sm font-medium text-brown mb-1">เบอร์โทรศัพท์</label>
            <input type="text" id="phone" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="098-519-2696" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Line ID</label>
            <input type="text" id="line" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="@waisira" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Facebook</label>
            <input type="text" id="facebook" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="https://facebook.com/waisira" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Instagram</label>
            <input type="text" id="instagram" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="https://instagram.com/waisira" />
          </div>
        </div>

        <!-- Trust Badges -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">⭐ Trust Badges</h3>
        <div class="mb-6">
          <label class="block text-sm font-medium text-brown mb-1">Trust Badges (JSON array ของ object ที่มี text และ icon)</label>
          <textarea id="trustBadges" rows="6" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs" placeholder='[{"text":"รับประกันงาน","icon":"✅"}]'></textarea>
          <p class="text-xs text-brown/40 mt-1">Format: &#91;&#123;"text":"ข้อความ","icon":"emoji"&#125;&#93;</p>
        </div>

        <!-- Footer Section -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">🏠 Footer</h3>
        <div class="space-y-4 mb-6">
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Footer Tagline</label>
            <input type="text" id="footerTagline" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ผู้เชี่ยวชาญด้านหินธรรมชาติคุณภาพพรีเมียม" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Footer About</label>
            <textarea id="footerAbout" rows="2" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ไวยศิลา นำเข้าและจำหน่ายหินอ่อน..."></textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">ที่อยู่บริษัท</label>
              <input type="text" id="footerAddress" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="กรุงเทพมหานคร ประเทศไทย" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">เวลาทำการ</label>
              <input type="text" id="footerHours" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="วันจันทร์ - วันเสาร์ 08:00 - 18:00 น." />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Quick Links (JSON)</label>
            <textarea id="footerQuickLinks" rows="4" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs" placeholder='[{"label":"หน้าแรก","url":"/"},{"label":"สินค้า","url":"/products"}]'></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Service Links (JSON)</label>
            <textarea id="footerServiceLinks" rows="4" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs" placeholder='[{"label":"ตัดหิน","url":"/services"},{"label":"เจาะหิน","url":"/services"}]'></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Copyright</label>
            <input type="text" id="footerCopyright" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="© 2026 ไวยศิลา (WAISIRA) สงวนลิขสิทธิ์" />
          </div>
        </div>

        <!-- Navbar Section -->
        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">🔗 Navbar Links</h3>
        <div class="mb-6">
          <label class="block text-sm font-medium text-brown mb-1">Navbar Items (JSON array)</label>
          <textarea id="navItems" rows="5" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs" placeholder='[{"href":"/","label":"หน้าแรก"},{"href":"/about","label":"เกี่ยวกับเรา"}]'></textarea>
          <p class="text-xs text-brown/40 mt-1">href = URL path, label = display text</p>
        </div>

        <!-- Save -->
        <div class="flex gap-4 pt-6 mt-6 border-t border-[#d4d0cb]">
          <button id="saveBtn" class="bg-terracotta text-cream px-8 py-2 rounded-md font-medium hover:bg-terracotta/90 transition-colors">
            💾 บันทึก
          </button>
          <div id="saveStatus" class="hidden py-2 text-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let settingsData = null;

    async function loadSettings() {
      try {
        const res = await fetch('/api/admin/settings', { credentials: 'include' });
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        settingsData = await res.json();
        console.log('[DEBUG] Settings loaded:', settingsData);
        renderForm(settingsData);
      } catch (err) { console.error(err); }
    }

    function renderForm(s) {
      const social = s.social || {};
      document.getElementById('phone').value = social.phone || '';
      document.getElementById('line').value = social.line || '';
      document.getElementById('facebook').value = social.facebook || '';
      document.getElementById('instagram').value = social.instagram || '';
      
      const badges = s.trustBadges || [];
      document.getElementById('trustBadges').value = JSON.stringify(badges, null, 2);
      
      // Footer fields
      const footer = s.footer || {};
      document.getElementById('footerTagline').value = footer.tagline || '';
      document.getElementById('footerAbout').value = footer.about || '';
      document.getElementById('footerQuickLinks').value = footer.quickLinks ? JSON.stringify(footer.quickLinks, null, 2) : '';
      document.getElementById('footerServiceLinks').value = footer.services ? JSON.stringify(footer.services, null, 2) : '';
      document.getElementById('footerCopyright').value = footer.copyright || '';
      document.getElementById('footerAddress').value = footer.address || '';
      document.getElementById('footerHours').value = footer.hours || '';
      
      // Navbar items
      document.getElementById('navItems').value = s.navItems ? JSON.stringify(s.navItems, null, 2) : '';
    }

    document.getElementById('saveBtn').addEventListener('click', async () => {
      const btn = document.getElementById('saveBtn');
      const status = document.getElementById('saveStatus');
      btn.disabled = true;
      btn.textContent = 'กำลังบันทึก...';
      status.classList.add('hidden');

      // Parse trustBadges
      let trustBadges = [];
      const tbRaw = document.getElementById('trustBadges').value.trim();
      if (tbRaw) {
        try { trustBadges = JSON.parse(tbRaw); }
        catch (e) { alert('รูปแบบ Trust Badges JSON ไม่ถูกต้อง'); btn.disabled = false; btn.textContent = '💾 บันทึก'; return; }
      }

      // Parse footer fields
      let footerQuickLinks = [];
      let footerServiceLinks = [];
      const fqRaw = document.getElementById('footerQuickLinks').value.trim();
      if (fqRaw) {
        try { footerQuickLinks = JSON.parse(fqRaw); }
        catch (e) { alert('รูปแบบ Quick Links JSON ไม่ถูกต้อง'); btn.disabled = false; btn.textContent = '💾 บันทึก'; return; }
      }
      const fsRaw = document.getElementById('footerServiceLinks').value.trim();
      if (fsRaw) {
        try { footerServiceLinks = JSON.parse(fsRaw); }
        catch (e) { alert('รูปแบบ Service Links JSON ไม่ถูกต้อง'); btn.disabled = false; btn.textContent = '💾 บันทึก'; return; }
      }
      
      // Parse navItems
      let navItems = [];
      const niRaw = document.getElementById('navItems').value.trim();
      if (niRaw) {
        try { navItems = JSON.parse(niRaw); }
        catch (e) { alert('รูปแบบ Navbar Items JSON ไม่ถูกต้อง'); btn.disabled = false; btn.textContent = '💾 บันทึก'; return; }
      }
      
      const data = {
        social: {
          phone: document.getElementById('phone').value,
          line: document.getElementById('line').value,
          facebook: document.getElementById('facebook').value,
          instagram: document.getElementById('instagram').value,
        },
        trustBadges,
        footer: {
          tagline: document.getElementById('footerTagline').value,
          about: document.getElementById('footerAbout').value,
          address: document.getElementById('footerAddress').value,
          hours: document.getElementById('footerHours').value,
          quickLinks: footerQuickLinks,
          services: footerServiceLinks,
          copyright: document.getElementById('footerCopyright').value,
        },
        navItems,
      };

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });
        if (res.ok) {
          status.textContent = '✅ บันทึกสำเร็จ!';
          status.classList.remove('hidden', 'text-red-500');
          status.classList.add('text-green-600');
          setTimeout(() => status.classList.add('hidden'), 3000);
          loadSettings();
        } else {
          const err = await res.text();
          status.textContent = '❌ ผิดพลาด: ' + err;
          status.classList.remove('hidden', 'text-green-600');
          status.classList.add('text-red-500');
        }
      } catch (err) {
        status.textContent = '❌ เกิดข้อผิดพลาด';
        status.classList.remove('hidden');
        status.classList.add('text-red-500');
      }
      btn.disabled = false;
      btn.textContent = '💾 บันทึก';
    });

    loadSettings();
  </script>
</AdminLayout>
