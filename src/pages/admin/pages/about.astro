---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { SESSION_COOKIE } from '../../../middleware/auth';

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<Layout title="เกี่ยวกับเรา | Admin ไวยศิลา">
  <div class="min-h-screen bg-[#e0dcd7]">
    <header class="bg-white border-b border-[#d4d0cb] sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/admin/pages" class="text-sm text-brown/60 hover:text-sage">← หน้าเพจ</a>
          <span class="text-brown/30">|</span>
          <h1 class="text-xl font-serif">🏢 เกี่ยวกับเรา</h1>
        </div>
        <a href="/about" target="_blank" class="text-sm text-brown/60 hover:text-sage">ดูเว็บไซต์ →</a>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-6 py-8">
      <div class="bg-white rounded-md border border-[#d4d0cb] p-6">
        <input type="hidden" id="pageId" />
        <input type="hidden" id="pageKey" value="about" />

        <div class="flex items-center gap-6 mb-6 pb-4 border-b border-[#d4d0cb]">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="pageActive" class="w-5 h-5 accent-sage" />
            <span class="text-sm font-medium text-brown">เปิดใช้งานหน้านี้</span>
          </label>
          <a href="/about" target="_blank" class="text-sm text-sage hover:underline ml-auto">ดูหน้าเพจ →</a>
        </div>

        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">🖼️ Hero Section</h3>
        <div class="space-y-4 mb-6">
          <div>
            <label class="block text-sm font-medium text-brown mb-1">รูปภาพ Hero</label>
            <input type="text" id="pageImages" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-sm" placeholder="/assets/hero.jpg" />
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Hero แท็กไลน์</label>
            <input type="text" id="pageHeroTagline" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="เกี่ยวกับเรา" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Hero หัวข้อ (pipe-separated)</label>
              <input type="text" id="pageHeroTitle" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ไวยศิลา|ผู้เชี่ยวชาญด้านหินธรรมชาติ" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">Hero สี</label>
              <input type="text" id="pageHeroTitleColors" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="white,cream" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">Hero คำอธิบาย</label>
            <textarea id="pageHeroInfo" rows="2" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ข้อความใต้หัวข้อ Hero"></textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">ปุ่ม CTA</label>
              <input type="text" id="pageHeroCTA" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="ติดต่อเรา" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-1">ลิงก์ปุ่ม CTA</label>
              <input type="text" id="pageHeroCTAUrl" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="/contact" />
            </div>
          </div>
        </div>

        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">⭐ ค่านิยมองค์กร</h3>
        <div class="mb-6">
          <label class="block text-sm font-medium text-brown mb-1">Values (JSON array)</label>
          <textarea id="pageValues" rows="8" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 font-mono text-xs" placeholder='[{"emoji":"🌍","title":"นำเข้าจากทั่วโลก","desc":"..."}]'></textarea>
          <p class="text-xs text-brown/40 mt-1">emoji, title, desc ของแต่ละค่านิยม</p>
        </div>

        <h3 class="text-sm font-medium text-brown mb-4 border-b border-[#d4d0cb] pb-2">📋 ข้อมูลทั่วไป</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-brown mb-1">ปีประสบการณ์</label>
            <input type="text" id="pageYearsExperience" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="15+" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-1">สี/สไตล์</label>
              <input type="text" id="pageColorStyle" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="มืออาชีพ, น่าเชื่อถือ" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">ข้อมูล/รายละเอียด</label>
            <textarea id="pageInformation" rows="5" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="รายละเอียดเกี่ยวกับบริษัท..."></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-brown mb-1">ติดต่อ</label>
            <input type="text" id="pageContact" class="w-full px-4 py-2 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50" placeholder="098-xxx-xxxx" />
          </div>
        </div>

        <div class="flex gap-4 pt-6 mt-6 border-t border-[#d4d0cb]">
          <button id="saveBtn" class="bg-terracotta text-cream px-8 py-2 rounded-md font-medium hover:bg-terracotta/90 transition-colors">💾 บันทึก</button>
          <div id="saveStatus" class="hidden py-2 text-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function loadPage() {
      try {
        const res = await fetch('/api/admin/pages', { credentials: 'include' });
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        const pages = await res.json();
        const p = pages.find((pg: any) => pg.key === 'about');
        if (!p) { document.body.innerHTML = '<p class="p-8 text-center text-red-500">ไม่พบข้อมูลหน้าเกี่ยวกับเรา</p>'; return; }
        document.getElementById('pageId').value = p.id || '';
        document.getElementById('pageActive').checked = p.active !== false;
        document.getElementById('pageImages').value = (p.images || []).join(', ');
        document.getElementById('pageHeroTagline').value = p.heroTagline || '';
        document.getElementById('pageHeroTitle').value = p.heroTitle || '';
        document.getElementById('pageHeroTitleColors').value = p.heroTitleColors || '';
        document.getElementById('pageHeroInfo').value = p.heroInfo || '';
        document.getElementById('pageHeroCTA').value = p.heroCTA || '';
        document.getElementById('pageHeroCTAUrl').value = p.heroCTAUrl || '/contact';
        document.getElementById('pageValues').value = p.values ? JSON.stringify(p.values, null, 2) : '';
        document.getElementById('pageYearsExperience').value = p.yearsExperience || '';
        document.getElementById('pageColorStyle').value = p.colorStyle || '';
        document.getElementById('pageInformation').value = p.information || '';
        document.getElementById('pageContact').value = p.contact || '';
      } catch (err) { console.error(err); }
    }

    document.getElementById('saveBtn').addEventListener('click', async () => {
      const btn = document.getElementById('saveBtn');
      const status = document.getElementById('saveStatus');
      btn.disabled = true; btn.textContent = 'กำลังบันทึก...';
      status.classList.add('hidden');

      const images = document.getElementById('pageImages').value.split(',').map((s: string) => s.trim()).filter(Boolean);
      const data: any = {
        id: document.getElementById('pageId').value,
        active: document.getElementById('pageActive').checked,
        images,
        heroTagline: document.getElementById('pageHeroTagline').value,
        heroTitle: document.getElementById('pageHeroTitle').value,
        heroTitleColors: document.getElementById('pageHeroTitleColors').value,
        heroInfo: document.getElementById('pageHeroInfo').value,
        heroCTA: document.getElementById('pageHeroCTA').value,
        heroCTAUrl: document.getElementById('pageHeroCTAUrl').value,
        yearsExperience: document.getElementById('pageYearsExperience').value,
        colorStyle: document.getElementById('pageColorStyle').value,
        information: document.getElementById('pageInformation').value,
        contact: document.getElementById('pageContact').value,
      };

      const valsRaw = document.getElementById('pageValues').value.trim();
      if (valsRaw) {
        try { data.values = JSON.parse(valsRaw); }
        catch (e) { alert('รูปแบบ Values JSON ไม่ถูกต้อง'); btn.disabled = false; btn.textContent = '💾 บันทึก'; return; }
      }

      try {
        const res = await fetch('/api/admin/pages', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data), credentials: 'include' });
        if (res.ok) {
          status.textContent = '✅ บันทึกสำเร็จ!'; status.classList.remove('hidden', 'text-red-500'); status.classList.add('text-green-600');
          setTimeout(() => status.classList.add('hidden'), 3000);
          loadPage();
        } else {
          const err = await res.text();
          status.textContent = '❌ ผิดพลาด: ' + err; status.classList.remove('hidden', 'text-green-600'); status.classList.add('text-red-500');
        }
      } catch (err) {
        status.textContent = '❌ เกิดข้อผิดพลาด'; status.classList.remove('hidden'); status.classList.add('text-red-500');
      }
      btn.disabled = false; btn.textContent = '💾 บันทึก';
    });

    loadPage();
  </script>
</Layout>
