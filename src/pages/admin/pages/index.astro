---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { SESSION_COOKIE } from '../../../middleware/auth';

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<Layout title="จัดการหน้าเพจ | ไวยศิลา">
  <div class="min-h-screen bg-[#e0dcd7]">
    <header class="bg-white border-b border-[#d4d0cb] sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/admin" class="text-sm text-brown/60 hover:text-sage">← กลับ Admin</a>
          <span class="text-brown/30">|</span>
          <h1 class="text-xl font-serif">จัดการหน้าเพจ</h1>
        </div>
        <a href="/" target="_blank" class="text-sm text-brown/60 hover:text-sage">ดูเว็บไซต์ →</a>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-6 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/admin/pages/homepage" class="bg-white border border-[#d4d0cb] rounded-md p-6 hover:border-sage hover:shadow-md transition-all group">
          <div class="text-3xl mb-3">🏠</div>
          <h2 class="text-lg font-serif text-brown group-hover:text-sage">หน้าแรก</h2>
          <p class="text-sm text-brown/50 mt-1">Hero, Trust Badges, ข้อมูลหลัก</p>
        </a>

        <a href="/admin/pages/service" class="bg-white border border-[#d4d0cb] rounded-md p-6 hover:border-sage hover:shadow-md transition-all group">
          <div class="text-3xl mb-3">🔧</div>
          <h2 class="text-lg font-serif text-brown group-hover:text-sage">บริการ</h2>
          <p class="text-sm text-brown/50 mt-1">รายการบริการ 6 อย่าง</p>
        </a>

        <a href="/admin/pages/contact" class="bg-white border border-[#d4d0cb] rounded-md p-6 hover:border-sage hover:shadow-md transition-all group">
          <div class="text-3xl mb-3">📞</div>
          <h2 class="text-lg font-serif text-brown group-hover:text-sage">ติดต่อ</h2>
          <p class="text-sm text-brown/50 mt-1">ช่องทางติดต่อ, Social</p>
        </a>

        <a href="/admin/pages/about" class="bg-white border border-[#d4d0cb] rounded-md p-6 hover:border-sage hover:shadow-md transition-all group">
          <div class="text-3xl mb-3">🏢</div>
          <h2 class="text-lg font-serif text-brown group-hover:text-sage">เกี่ยวกับเรา</h2>
          <p class="text-sm text-brown/50 mt-1">Hero, ค่านิยม, ประสบการณ์</p>
        </a>

        <a href="/admin/pages/portfolio" class="bg-white border border-[#d4d0cb] rounded-md p-6 hover:border-sage hover:shadow-md transition-all group">
          <div class="text-3xl mb-3">🖼️</div>
          <h2 class="text-lg font-serif text-brown group-hover:text-sage">ผลงาน</h2>
          <p class="text-sm text-brown/50 mt-1">รายการผลงาน</p>
        </a>
      </div>
    </div>
  </div>
</Layout>
