---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

const currentPage = '/services';

let pageData = { images: [], colorStyle: '', sizeText: '', information: '', contact: '', active: true, services: [] };

import { readJson } from '../lib/jsonDb';
const allData = readJson();
const pageRecord = allData.pages?.find((p: any) => p.key === 'service');
if (pageRecord) {
  pageData = pageRecord;
}

const heroImages = pageData.images?.length > 0 ? pageData.images : ['/assets/services/workshop-hero.jpg'];
const colorStyle = pageData.colorStyle || '';
const sizeText = pageData.sizeText || '';
const information = pageData.information || '';
const contact = pageData.contact || '';
const servicesList = pageData.services || [];

// Serialize for client
const servicesJson = JSON.stringify(servicesList);
---

<Layout title="บริการ">
  <NavBar currentPage={currentPage} />

  <section class="pt-32 pb-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="rounded-md overflow-hidden mb-12" style="height: 320px;">
        <img src={heroImages[0]} alt="ไวยศิลา workshop" class="w-full h-full object-cover" id="heroImage" />
      </div>
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-4">บริการ</p>
      <h1 class="text-5xl font-heading leading-[1.1] mb-6">บริการของเรา</h1>
      <p class="text-lg text-brown/70 max-w-2xl leading-relaxed mb-16" id="infoText">
        {information || 'ทางร้านมีบริการ ตัด เจาะ เจียร์ แกะสลักป้าย พ่นทราย พ่นไฟ เซาะร่อง ทาน้ำยากันซึม และยังมีบริการวัดขนาดหน้างาน พร้อมจัดส่งสินค้า'}
      </p>
      <!--
      {colorStyle && (
        <div class="mb-8 px-4 py-3 bg-sage/10 rounded-md inline-block" id="colorStyleBadge">
          <span class="text-sm text-brown/70">สไตล์: {colorStyle}</span>
        </div>
      )}
       -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" id="servicesGrid">
        <!-- Services rendered by JS -->
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-8" id="additionalServices"></div>

      <!--
      {sizeText && (
        <div class="mt-8 p-4 bg-brown/5 rounded-md" id="sizeTextBox">
          <p class="text-sm text-brown/70">ขนาดที่รองรับ: {sizeText}</p>
        </div>
      )}
    </div> -->
  
  </section>

  <Footer />

  <script is:inline define:vars={{ servicesJson, heroImages, colorStyle, sizeText, information, contact }}>
    const defaultServices = [
      { num: '01', title: 'ตัดหิน', desc: 'บริการตัดหินด้วยเครื่องจักรคุณภาพสูง ตัดได้ทุกขนาด ตามความต้องการของลูกค้า รองรับงานทั้งหินอ่อน หินแกรนิต และหินสังเคราะห์', image: '/assets/services/cut.jpg' },
      { num: '02', title: 'เจาะหิน', desc: 'เจาะรูและร่องลึกบนหิน สำหรับติดตั้งอุปกรณ์หรือตกแต่งตามแบบแปลน', image: '/assets/services/drill.jpg' },
      { num: '03', title: 'เจียร์หิน', desc: 'ขัดและเจียร์ผิวหินให้เรียบเกลี้ยง พร้อมส่งมอบงานคุณภาพ', image: '/assets/services/grind.jpg' },
      { num: '04', title: 'แกะสลัก', desc: 'แกะสลักป้ายและลวดลายต่างๆ บนหิน ตามแบบที่ต้องการ', image: '/assets/services/engrave.jpg' },
      { num: '05', title: 'พ่นผิวหน้า', desc: 'พ่นทราย พ่นไฟ เซาะร่อง สร้างผิวสัมผัสที่ต้องการ', image: '/assets/services/spray.jpg' },
      { num: '06', title: 'ทากันซึม', desc: 'ทาน้ำยากันซึม ป้องกันน้ำซึมเข้าเนื้อหิน ยืดอายุการใช้งาน', image: '/assets/services/seal.jpg' }
    ];
    
    let servicesData = [];
    try {
      servicesData = JSON.parse(servicesJson);
    } catch (e) {
      console.error('Failed to parse servicesJson:', e);
    }
    
    const services = servicesData.length > 0 ? servicesData : defaultServices;
    
    const servicesGrid = document.getElementById('servicesGrid');

    const additionalServices = document.getElementById('additionalServices');
    
    if (servicesGrid && services.length >= 2) {
      servicesGrid.innerHTML = 
        '<div class="lg:col-span-2 bg-[#e0dcd7] rounded-md p-10 lg:p-12">' +
          '<div class="rounded-md overflow-hidden mb-6" style="height: 240px;">' +
            '<img src="' + services[0].image + '" alt="' + services[0].title + '" class="w-full h-full object-cover" />' +
          '</div>' +
          '<span class="text-6xl font-heading text-brown/10 block mb-4">' + services[0].num + '</span>' +
          '<h2 class="text-3xl font-heading mb-3">' + services[0].title + '</h2>' +
          '<p class="text-brown/60 leading-relaxed">' + services[0].desc + '</p>' +
        '</div>' +
        '<div class="bg-[#e0dcd7] rounded-md p-8">' +
          '<div class="rounded-md overflow-hidden mb-4" style="height: 160px;">' +
            '<img src="' + services[1].image + '" alt="' + services[1].title + '" class="w-full h-full object-cover" />' +
          '</div>' +
          '<span class="text-5xl font-heading text-brown/10 block mb-4">' + services[1].num + '</span>' +
          '<h2 class="text-2xl font-heading mb-3">' + services[1].title + '</h2>' +
          '<p class="text-brown/60 leading-relaxed text-sm">' + services[1].desc + '</p>' +
        '</div>';
    }
    
    if (additionalServices && services.length > 2) {
      let html = '';
      for (let i = 2; i < services.length; i++) {
        html += '<div class="bg-[#e0dcd7] rounded-md p-6">' +
          '<div class="rounded-md overflow-hidden mb-4" style="height: 140px;">' +
            '<img src="' + services[i].image + '" alt="' + services[i].title + '" class="w-full h-full object-cover" />' +
          '</div>' +
          '<span class="text-4xl font-heading text-brown/10 block mb-3">' + services[i].num + '</span>' +
          '<h2 class="text-xl font-heading mb-2">' + services[i].title + '</h2>' +
          '<p class="text-sm text-brown/60">' + services[i].desc + '</p>' +
        '</div>';
      }
      additionalServices.innerHTML = html;
    }
  </script>

</Layout>
