---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Auto Contrast Test">
  <div class="pt-32 px-6 max-w-4xl mx-auto">
    <h1 class="text-4xl font-heading mb-8">Auto Contrast Test</h1>
    
    <!-- Light backgrounds → dark text -->
    <section class="bg-[#EDE9E6] p-8 rounded-lg mb-6">
      <h2 class="text-2xl font-heading mb-2">bg-cream #EDE9E6</h2>
      <p class="text-lg">ข้อความภาษาไทย - พื้นหลังสีอ่อน = ตัวอักษรสีเข้ม</p>
      <p class="text-sm text-brown/60">Luminance: 0.894 (bright)</p>
    </section>
    
    <section class="bg-[#d4d0cb] p-8 rounded-lg mb-6">
      <h2 class="text-2xl font-heading mb-2">bg-gray #d4d0cb</h2>
      <p class="text-lg">ข้อความภาษาไทย - พื้นหลังสีเทา = ตัวอักษรสีเข้ม</p>
      <p class="text-sm text-brown/60">Luminance: 0.528 (medium)</p>
    </section>
    
    <section class="bg-[#C9996B] p-8 rounded-lg mb-6">
      <h2 class="text-2xl font-heading mb-2">bg-terracotta #C9996B</h2>
      <p class="text-lg">ข้อความภาษาไทย - พื้นหลังสีแดงอิฐ = ตัวอักษรสีเข้ม</p>
      <p class="text-sm text-white/70">Luminance: 0.304 (medium)</p>
    </section>
    
    <!-- Dark backgrounds → light text -->
    <section class="bg-[#5C766D] p-8 rounded-lg mb-6">
      <h2 class="text-2xl font-heading mb-2">bg-sage #5C766D</h2>
      <p class="text-lg">ข้อความภาษาไทย - พื้นหลังสีเขียวเข้ม = ตัวอักษรสีขาว</p>
      <p class="text-sm text-white/70">Luminance: 0.129 (dark)</p>
    </section>
    
    <section class="bg-[#5C4F4A] p-8 rounded-lg mb-6">
      <h2 class="text-2xl font-heading mb-2">bg-brown #5C4F4A</h2>
      <p class="text-lg">ข้อความภาษาไทย - พื้นหลังสีน้ำตาลเข้ม = ตัวอักษรสีขาว</p>
      <p class="text-sm text-white/70">Luminance: 0.053 (dark)</p>
    </section>
    
    <section class="bg-[#1a1a1a] p-8 rounded-lg mb-6">
      <h2 class="text-2xl font-heading mb-2">bg-black #1a1a1a</h2>
      <p class="text-lg">ข้อความภาษาไทย - พื้นหลังดำ = ตัวอักษรสีขาว</p>
      <p class="text-sm text-white/70">Luminance: 0.011 (very dark)</p>
    </section>
    
    <!-- Manual override test -->
    <section class="bg-[#5C766D] p-8 rounded-lg">
      <h2 class="text-2xl font-heading mb-2">Manual Override Test</h2>
      <p class="text-lg">ข้อความปกติ - ควรเป็นสีขาว</p>
      <p class="text-lg" data-contrast="manual" style="color: #FFD700;">ข้อความสีทอง - override ด้วย data-contrast="manual"</p>
    </section>
  </div>
</Layout>
