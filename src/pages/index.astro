---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

const currentPage = '/';

// Read from MongoDB (with JSON fallback)
import { readPages, readPortfolio, readTestimonials, readSettings } from '../lib/jsonDb';
const [allPages, settings, portfolioRaw, testimonials] = await Promise.all([
  readPages(),
  readSettings(),
  readPortfolio(),
  readTestimonials(),
]);
const homepageData = allPages.find((p: any) => p.key === 'homepage') || {};
const serviceData = allPages.find((p: any) => p.key === 'service') || {};

// Trust badges from settings
const trustBadges = settings.trustBadges || [
  { text: 'รับประกันงาน', icon: '✅' },
  { text: 'ส่งมอบตรงเวลา', icon: '✅' },
  { text: 'วัสดุเกรด A', icon: '✅' },
  { text: 'ลูกค้ากว่า 500+ ราย', icon: '✅' },
];

// Hero section — use heroImages array from admin
const heroSlides = homepageData.images?.length > 0 ? homepageData.images : ['/assets/hero.jpg'];
const heroTagline = homepageData.heroTagline || 'สุดหรู สุดประณีต สำหรับคนพิเศษ';
const heroTitleLines = (homepageData.heroTitle || 'งานหินอ่อน|หินแกรนิต|หินสังเคราะห์|ระดับพรีเมียม').split('|');
const heroTitleColors = (homepageData.heroTitleColors || 'white,cream,cream/80,cream/60,cream').split(',');
const heroInfo = homepageData.heroInfo || homepageData.information || '';
const heroCTA = homepageData.heroCTA || 'นัดประเมินราคาฟรี';
const heroCTAUrl = homepageData.heroCTAUrl || '/contact';

// Homepage services preview (from service page data)
const homepageServices = serviceData.services?.slice(0, 6) || [];

// Page info
const information = homepageData.information || '';
const contact = homepageData.contact || '098-519-2696';

// Get portfolio items for preview
const portfolioItems = portfolioRaw.filter((p: any) => p.active).slice(0, 3);

// Story/About section fields
const storyHeading = homepageData.storyHeading || 'ผู้เชี่ยวชาญด้านหินธรรมชาติ';
const storySubheading = homepageData.storySubheading || 'เรื่องราวของเรา';
const aboutText = homepageData.aboutText || '';
const experienceLabel = homepageData.experienceLabel || 'ปีแห่งประสบการณ์';
const factoryImage = homepageData.factoryImage || '/assets/services/factory-interior.jpg';

// Testimonials for review section
const testimonialsJson = JSON.stringify(testimonials);
---

<Layout title="ไวยศิลา | หินอ่อน หินแกรนิต หินควอทซ์ คุณภาพพรีเมียม">
  <NavBar currentPage={currentPage} />

  <!-- Hero -->
  <section class="pt-40 pb-24 px-6 relative" id="hero-section">
    <div class="absolute inset-0 z-0">
      <div id="hero-slides" class="absolute inset-0">
        {heroSlides.map((src: string, i: number) => (
          <img src={src} alt="หินหรู" class={`hero-slide absolute inset-0 w-full h-full object-cover${i > 0 ? ' hidden' : ''}`} loading={i === 0 ? 'eager' : 'lazy'} />
        ))}
        {heroSlides.length === 0 && (
          <img src="/assets/hero.jpg" alt="หินหรู" class="hero-slide absolute inset-0 w-full h-full object-cover" loading="eager" />
        )}
      </div>
      <!-- Dark gradient overlay for text contrast -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/40 to-transparent"></div>
    </div>
    <div class="max-w-6xl mx-auto relative z-10">
      <div class="max-w-2xl">
        <p class="text-xs font-medium tracking-[0.2em] uppercase text-white/90 mb-4">{heroTagline}</p>
        <h1 class="text-5xl lg:text-6xl font-heading leading-[1.1] mb-6 text-white">
{heroTitleLines.map((line, i) => (
          <><span style={i === 0 ? {} : { color: heroTitleColors[i] === 'cream' ? '#EDE9E6' : heroTitleColors[i] === 'cream/80' ? 'rgba(237,233,230,0.8)' : heroTitleColors[i] === 'cream/60' ? 'rgba(237,233,230,0.6)' : '#EDE9E6' }}>{line}</span>{i < heroTitleLines.length - 1 ? <br/> : ''}</>
        ))}
</h1>
        <p class="text-lg text-white/80 leading-relaxed max-w-md mb-6" id="heroInfo">
          {heroInfo || 'ยกระดับความหรูหราให้พื้นที่ของคุณ ด้วยหินธรรมชาติคุณภาพระดับ World Class ที่คัดสรรมาอย่างพิถีพิถัน'}
        </p>
        <a href={heroCTAUrl} class="inline-block bg-cream text-brown px-6 py-3 rounded-md font-medium hover:bg-white transition-colors">{heroCTA}</a>
      </div>
  
    </div>
  </section>

  <!-- About/Story Section -->
  {storyHeading && (
  <section class="py-24 px-6 bg-sand" data-bg="#e0dcd7">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">{storySubheading || 'เรื่องราวของเรา'}</p>
          <h2 class="text-3xl font-heading mb-6">{storyHeading}</h2>
          {aboutText && <p class="text-brown/70 leading-relaxed mb-8">{aboutText}</p>}
          {experienceLabel && (
            <div class="inline-flex items-center gap-3 bg-sage/10 px-5 py-3 rounded-md">
              <span class="text-2xl font-heading text-sage">✦</span>
              <span class="text-sm font-medium text-brown">{experienceLabel}</span>
            </div>
          )}
        </div>
        <div class="rounded-md overflow-hidden aspect-[4/3]">
          <img src={factoryImage} alt="โรงงานของเรา" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- Services -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">{storyHeading || 'บริการ'}</p>
          <h2 class="text-3xl font-heading">{storyHeading ? 'บริการของเรา' : 'บริการของเรา'}</h2>
        </div>
        <a href="/services" class="text-sm font-medium underline underline-offset-4 hover:text-sage transition-colors">ดูทั้งหมด</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 justify-items-center">
        {homepageServices.map((s: any) => (
          <div class="text-center">
            <div class="rounded-md mb-3 overflow-hidden aspect-square w-full max-w-[220px] mx-auto">
              <img src={s.image} alt={s.title} class="w-full h-full object-cover rounded-md" loading="lazy" />
            </div>
            <p class="text-base font-bold">{s.title}</p>
            <p class="text-xs text-brown/60 mt-1 px-2">{s.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-brown/60 text-sm mt-8">
        {homepageData.servicesText || 'บริการตัด เจาะ เจียร์ แกะสลักป้าย พ่นทราย พ่นไฟ เซาะร่อง ทาน้ำยากันซึม พร้อมวัดขนาดหน้างานและจัดส่งสินค้า'}
      </p>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-24 px-6 bg-pebble overflow-hidden" data-bg="#d4d0cb">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-base font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">{homepageData.testimonialLabel || 'รีวิวจากลูกค้า'}</p>
        <h2 class="text-4xl font-heading">{homepageData.testimonialHeading || 'ลูกค้าของเราพูดอย่างไร'}</h2>
      </div>
    </div>
    <div class="relative">
      <!-- Server-rendered testimonials data -->
      <div id="testimonials-data" class="hidden" data-testimonials={testimonialsJson}></div>
      <div id="testimonial-track" class="flex gap-6" style="width: max-content;"></div>
    </div>
  </section>

  <script is:inline>
    (function() {
      // Read testimonials from server-rendered data attribute
      var iconMap = { facebook: '📘', line: '📱', instagram: '📷' };
      var el = document.getElementById('testimonials-data');
      var testimonials = el ? JSON.parse(el.dataset.testimonials || '[]') : [];
      var reviews = testimonials.map(function(t) {
        return { name: t.name, i: t.initial, txt: t.text, icon: iconMap[t.icon] || '📘' };
      });
      function card(n,i,t,ico){return'<div class="bg-cream p-6 rounded-md w-80 flex-shrink-0"><div class="flex gap-1 mb-3 text-terracotta text-lg">★★★★★</div><p class="text-brown/80 mb-4 text-lg leading-relaxed">"'+t+'"</p><div class="flex items-center gap-3"><div class="bg-sage/20 w-12 h-12 rounded-full flex items-center justify-center text-sage font-bold">'+i+'</div><div><p class="font-medium text-lg">'+n+'</p><div class="flex items-center gap-2 text-sm text-brown/60">'+ico+'</div></div></div></div>';}
      function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}
      var tr=document.getElementById('testimonial-track');
      if(!tr)return;
      var shuffled = shuffle(reviews.slice());
      var all='';
      for(var k=0;k<shuffled.length;k++){var r=shuffled[k];all+=card(r.name,r.i,r.txt,r.icon);}
      tr.innerHTML=all+all;
      var pos=0;
      function s(){pos+=0.5;var half=tr.scrollWidth/2;if(pos>=half)pos=0;tr.style.transform='translateX(-'+pos+'px)';requestAnimationFrame(s);}
      setTimeout(s,600);
    })();

    // Hero Slider Auto-play
    (function() {
      var slides = document.querySelectorAll('.hero-slide');
      if (slides.length === 0) return;
      var current = 0;
      function next() {
        slides[current].classList.add('hidden');
        slides[current].classList.remove('block');
        current = (current + 1) % slides.length;
        slides[current].classList.remove('hidden');
        slides[current].classList.add('block');
      }
      setInterval(next, 3000);
    })();
  </script>

  <!-- Products Preview -->
  <section class="py-24 px-6 bg-sand" data-bg="#e0dcd7">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">{homepageData.productsLabel || 'หมวดสินค้า'}</p>
          <h2 class="text-3xl font-heading">{homepageData.productsHeading || 'สินค้าของเรา'}</h2>
        </div>
        <a href="/products" class="text-sm font-medium underline underline-offset-4 hover:text-sage transition-colors">ดูทั้งหมด</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        {(homepageData.categories || []).map((cat: any, i: number) => (
          <a href="/products" class="group">
            <div class="bg-pebble rounded-md aspect-square mb-4 overflow-hidden">
              <img src={cat.image || ['/assets/products/category-marble.jpg','/assets/products/category-granite.jpg','/assets/products/category-artificial.jpg','/assets/products/category-quartz.jpg'][i]} alt={cat.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <h3 class="font-heading text-xl mb-1">{cat.name || ['หินอ่อน','หินแกรนิต','หินสังเคราะห์','หินควอทซ์'][i]}</h3>
            <p class="text-sm text-brown/60">{cat.en || ''}</p>
          </a>
        ))}
        {/* Fallback if no categories set in admin */}
        {(homepageData.categories || []).length === 0 && [
          { name: 'หินอ่อน', en: 'Marble', img: '/assets/products/category-marble.jpg' },
          { name: 'หินแกรนิต', en: 'Granite', img: '/assets/products/category-granite.jpg' },
          { name: 'หินสังเคราะห์', en: 'Artificial', img: '/assets/products/category-artificial.jpg' },
          { name: 'หินควอทซ์', en: 'Quartz', img: '/assets/products/category-quartz.jpg' },
        ].map((f, i) => (
          <a href="/products" class="group">
            <div class="bg-pebble rounded-md aspect-square mb-4 overflow-hidden">
              <img src={f.img} alt={f.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <h3 class="font-heading text-xl mb-1">{f.name}</h3>
            <p class="text-sm text-brown/60">{f.en}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Portfolio Preview -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">{homepageData.portfolioLabel || 'ผลงาน'}</p>
          <h2 class="text-3xl font-heading">{homepageData.portfolioHeading || 'ผลงานติดตั้ง'}</h2>
        </div>
        <a href="/portfolio" class="text-sm font-medium underline underline-offset-4 hover:text-sage transition-colors">ดูทั้งหมด</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {portfolioItems.length > 0 ? (
          portfolioItems.map((p: any) => (
            <a href={`/portfolio/${p.slug}`} class="group">
              <div class="bg-pebble rounded-md aspect-[4/3] mb-4 overflow-hidden">
                <img 
                  src={p.image || p.images?.[0] || '/assets/portfolio/marble-01.jpg'} 
                  alt={p.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy"
                />
              </div>
              <h3 class="font-heading text-lg mb-1">{p.title}</h3>
              <p class="text-sm text-brown/60">{p.category || ''}</p>
            </a>
          ))
        ) : (
          <>
            <a href="/portfolio" class="group">
              <div class="bg-pebble rounded-md aspect-[4/3] mb-4 overflow-hidden">
                <img src="/assets/portfolio/marble-01.jpg" alt="หินอ่อน | Marble" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
              <h3 class="font-heading text-lg mb-1">หินอ่อน | Marble</h3>
            </a>
            <a href="/portfolio" class="group">
              <div class="bg-pebble rounded-md aspect-[4/3] mb-4 overflow-hidden">
                <img src="/assets/portfolio/granite-01.jpg" alt="หินแกรนิต | Granite" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
              <h3 class="font-heading text-lg mb-1">หินแกรนิต | Granite</h3>
            </a>
            <a href="/portfolio" class="group">
              <div class="bg-pebble rounded-md aspect-[4/3] mb-4 overflow-hidden">
                <img src="/assets/portfolio/quartz-01.jpg" alt="หินเทียม | หินสังเคราะห์" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
              <h3 class="font-heading text-lg mb-1">หินเทียม | หินสังเคราะห์</h3>
            </a>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-24 px-6 bg-terracotta/10" data-bg="#C9996B">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-heading mb-4">{homepageData.ctaHeading || 'สนใจสินค้าหรือบริการ?'}</h2>
      <p class="text-brown/70 mb-8" id="contactCta">{homepageData.ctaSubtext || 'ติดต่อเราได้ตลอดเวลา'} {contact}</p>
      <a href="/contact" class="inline-block bg-terracotta text-cream px-8 py-4 rounded-md font-medium hover:bg-terracotta/90 transition-colors">ติดต่อเลย</a>
    </div>
  </section>

  <Footer />

</Layout>
