---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

const currentPage = '/';

// Read directly from JSON for SSR
import { readJson } from '../lib/jsonDb';
let pageData = { images: [], colorStyle: '', sizeText: '', information: '', contact: '', active: true };

const allData = readJson();
const pageRecord = allData.pages?.find((p: any) => p.key === 'homepage');
if (pageRecord) {
  pageData = pageRecord;
}

const heroImages = pageData.images?.length > 0 ? pageData.images : ['/assets/hero.jpg'];
const colorStyle = pageData.colorStyle || '';
const sizeText = pageData.sizeText || '';
const information = pageData.information || '';
const contact = pageData.contact || '098-519-2696';
---

<Layout title="เกี่ยวกับเรา">
  <NavBar currentPage={currentPage} />

  <!-- Trust Badge Strip -->
  <section class="bg-cream/95 border-y border-brown/10 py-3 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap justify-center gap-6 md:gap-12 text-sm">
        <div class="flex items-center gap-2 text-brown/80">
          <span class="text-lg">🏆</span>
          <span>รับรองคุณภาพมาตรฐาน</span>
        </div>
        <div class="flex items-center gap-2 text-brown/80">
          <span class="text-lg">🕐</span>
          <span>บริการมากว่า 30 ปี</span>
        </div>
        <div class="flex items-center gap-2 text-brown/80">
          <span class="text-lg">🚚</span>
          <span>จัดส่งฟรีทั่วประเทศ</span>
        </div>
        <div class="flex items-center gap-2 text-brown/80">
          <span class="text-lg">✅</span>
          <span>ช่างมืออาชีพ</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero -->
  <section class="pt-40 pb-24 px-6 relative" id="hero-section">
    <div class="absolute inset-0 z-0">
      <div id="hero-slides" class="absolute inset-0">
        <img src="/assets/hero-slider/marble-crema-marfil.jpg" alt="หินหรู" class="hero-slide absolute inset-0 w-full h-full object-cover" />
        <img src="/assets/hero-slider/marble-travertino.jpg" alt="หินหรู" class="hero-slide absolute inset-0 w-full h-full object-cover hidden" />
        <img src="/assets/hero-slider/quartz-carrara-white.jpg" alt="หินหรู" class="hero-slide absolute inset-0 w-full h-full object-cover hidden" />
        <img src="/assets/hero-slider/quartz-matte-white.jpg" alt="หินหรู" class="hero-slide absolute inset-0 w-full h-full object-cover hidden" />
        <img src="/assets/hero-slider/granite-nero-absolute.jpg" alt="หินหรู" class="hero-slide absolute inset-0 w-full h-full object-cover hidden" />
        <img src="/assets/hero-slider/install-marble-staircase.jpg" alt="หินหรู" class="hero-slide absolute inset-0 w-full h-full object-cover hidden" />
      </div>
      <!-- Dark gradient overlay for text contrast -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/40 to-transparent"></div>
    </div>
    <div class="max-w-6xl mx-auto relative z-10">
      <div class="max-w-2xl">
        <p class="text-xs font-medium tracking-[0.2em] uppercase text-white/90 mb-4">สุดหรู สุดประณีต สำหรับคนพิเศษ</p>
        <h1 class="text-5xl lg:text-6xl font-heading leading-[1.1] mb-6 text-white">งาน<span class="text-cream">หินอ่อน</span><br/><span class="text-cream/80">หินแกรนิต</span><br/><span class="text-cream/60">หินสังเคราะห์</span><br/><span class="text-cream">ระดับพรีเมียม</span></h1>
        <p class="text-lg text-white/80 leading-relaxed max-w-md mb-6" id="heroInfo">
          {information || 'ยกระดับความหรูหราให้พื้นที่ของคุณ ด้วยหินธรรมชาติคุณภาพระดับ World Class ที่คัดสรรมาอย่างพิถีพิถัน'}
        </p>
        <a href="/contact" class="inline-block bg-cream text-brown px-6 py-3 rounded-md font-medium hover:bg-white transition-colors">นัดประเมินราคาฟรี</a>
      </div>
  
    </div>
  </section>

  <!-- Services -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">บริการ</p>
          <h2 class="text-3xl font-heading">บริการของเรา</h2>
        </div>
        <a href="/services" class="text-sm font-medium underline underline-offset-4 hover:text-sage transition-colors">ดูทั้งหมด</a>
      </div>
      <div class="flex gap-6 flex-wrap justify-center">
        <div class="text-center flex-shrink-0">
          <div class="rounded-md mb-3 overflow-hidden" style="width: 220px; height: 220px;">
            <img src="/assets/services/factory-interior.jpg" alt="ตัดหิน" class="w-full h-full object-cover rounded-md" />
          </div>
          <p class="text-base font-bold">ตัด</p>
          <p class="text-xs text-brown/60 mt-1 px-2">ตัดหินด้วยเครื่องจักรคุณภาพสูง รองรับทุกขนาด</p>
        </div>
        <div class="text-center flex-shrink-0">
          <div class="rounded-md mb-3 overflow-hidden" style="width: 220px; height: 220px;">
            <img src="/assets/services/worker.jpg" alt="เจาะหิน" class="w-full h-full object-cover rounded-md" />
          </div>
          <p class="text-base font-bold">เจาะ</p>
          <p class="text-xs text-brown/60 mt-1 px-2">เจาะรูและร่องลึก สำหรับติดตั้งอุปกรณ์</p>
        </div>
        <div class="text-center flex-shrink-0">
          <div class="rounded-md mb-3 overflow-hidden" style="width: 220px; height: 220px;">
            <img src="/assets/services/crane-loading.jpg" alt="เจียร์หิน" class="w-full h-full object-cover rounded-md" />
          </div>
          <p class="text-base font-bold">เจียร์</p>
          <p class="text-xs text-brown/60 mt-1 px-2">ขัดและเจียร์ผิวหินให้เรียบเกลี้ยง</p>
        </div>
        <div class="text-center flex-shrink-0">
          <div class="rounded-md mb-3 overflow-hidden" style="width: 220px; height: 220px;">
            <img src="/assets/services/engrave.jpg" alt="แกะสลัก" class="w-full h-full object-cover rounded-md" />
          </div>
          <p class="text-base font-bold">แกะสลัก</p>
          <p class="text-xs text-brown/60 mt-1 px-2">แกะสลักป้ายและลวดลายตามแบบ</p>
        </div>
      </div>
      <div class="flex gap-6 flex-wrap justify-center mt-6">
        <div class="text-center flex-shrink-0">
          <div class="rounded-md mb-3 overflow-hidden" style="width: 220px; height: 220px;">
            <img src="/assets/services/spray.jpg" alt="พ่นผิวหน้า" class="w-full h-full object-cover rounded-md" />
          </div>
          <p class="text-base font-bold">พ่นผิวหน้า</p>
          <p class="text-xs text-brown/60 mt-1 px-2">พ่นทราย พ่นไฟ เซาะร่อง สร้างผิวสัมผัส</p>
        </div>
        <div class="text-center flex-shrink-0">
          <div class="rounded-md mb-3 overflow-hidden" style="width: 220px; height: 220px;">
            <img src="/assets/services/seal.jpg" alt="ทากันซึม" class="w-full h-full object-cover rounded-md" />
          </div>
          <p class="text-base font-bold">ทากันซึม</p>
          <p class="text-xs text-brown/60 mt-1 px-2">ทาน้ำยากันซึม ป้องกันน้ำ ยืดอายุการใช้งาน</p>
        </div>
      </div>
      <p class="text-center text-brown/60 text-sm mt-8">
        บริการตัด เจาะ เจียร์ แกะสลักป้าย พ่นทราย พ่นไฟ เซาะร่อง ทาน้ำยากันซึม พร้อมวัดขนาดหน้างานและจัดส่งสินค้า
      </p>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-24 px-6 bg-[#d4d0cb] overflow-hidden" data-bg="#d4d0cb">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-base font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">รีวิวจากลูกค้า</p>
        <h2 class="text-4xl font-heading">ลูกค้าของเราพูดอย่างไร</h2>
      </div>
    </div>
    <div class="relative">
      <div id="testimonial-track" class="flex gap-6" style="width: max-content;"></div>
    </div>
  </section>

  <script is:inline>
    (function() {
      var reviews = [{name:"สก*** ห***",i:"สก",txt:"งานเสร็จเร็ว ช่างเป็นมิตร ประทับใจมากครับ หินสวยมาก",icon:"📘"},{name:"วิ*** ร***",i:"ว",txt:"แนะนำหินให้เหมาะกับงบ บริการดีเยี่ยม งานเสร็จตรงเวลา",icon:"📘"},{name:"ป*** ช***",i:"ป",txt:"ใช้บริการ 3 ครั้งแล้ว ทุกครั้งไม่ผิดหวัง ราคาโดนใจ",icon:"📱"},{name:"ทนง ศ***",i:"ท",txt:"หินควอทซ์ทำเคาน์เตอร์ครัว ผลงานเนียน ราคาโปร่งใส",icon:"📘"},{name:"อรุช ส***",i:"อ",txt:"ติดตั้งหินอ่อนโรงแรม ทีมช่างเซี้ยม ละเอียดมาก",icon:"📷"},{name:"สมศรี ไ***",i:"ส",txt:"หินสวยมากค่ะ เทียบแล้วคุณภาพดีกว่า ราคาถูกกว่าด้วย",icon:"📘"},{name:"ธนา ว***",i:"ธ",txt:"ดูแลตั้งแต่เลือกหินจนติดตั้งเสร็จ ประทับใจมาก",icon:"📱"},{name:"พิชัย ส***",i:"พ",txt:"หินแกรนิตที่สั่งมาสีสวยมาก ติดตั้งเสร็จเร็ว ช่างเป็นมืออาชีพ",icon:"📘"},{name:"สุภาพ ค***",i:"ส",txt:"บริการดีมากครับ พนักงานเป็นมิตร งานเนียนที่สุด",icon:"📘"},{name:"รัชพล ม***",i:"ร",txt:"ติดตั้งหินบันได สวยงามมากค่ะ ขอบคุณมาก",icon:"📱"},{name:"ณิชา น***",i:"ณ",txt:"ไวยศิลาแนะนำหินให้ดีมาก งานออกมาเกินความคาดหมาย",icon:"📷"},{name:"ประเสริฐ วั***",i:"ป",txt:"ราคาโดนใจ คุณภาพดีมาก ส่งมอบตรงเวลาครับ",icon:"📘"},{name:"มานพ อ***",i:"ม",txt:"หินอ่อน Italy สวยมากครับ ลูกค้าที่บ้านชมเยอะ",icon:"📘"},{name:"ศิริพร ส***",i:"ศ",txt:"งานประตูหินอ่อน สวยที่สุดเท่าที่เคยเห็นมา",icon:"📱"},{name:"วิทยา พ***",i:"ว",txt:"ติดตั้งหินปูทางเดิน รอบบ้าน สวยมากครับ",icon:"📘"},{name:"อุบล ร***",i:"อ",txt:"ไวยศิลารับงานเร็ว ช่างทำงานละเอียด พูดจาเป็นมิตร",icon:"📷"},{name:"ชัชวาล ส***",i:"ช",txt:"หินควอทซ์ขาว งานเสร็จเร็ว ช่างเซี้ยมมาก",icon:"📘"},{name:"นภา ท***",i:"น",txt:"ประทับใจมากค่ะ จะแนะนำเพื่อนๆ ต่อไป",icon:"📱"},{name:"สมชาย ว***",i:"ส",txt:"หินแกรนิตดำ ตกแต่งห้องน้น ดูหรูมากครับ",icon:"📘"},{name:"ปิยะ ศ***",i:"ป",txt:"บริการหลังการขายดีมาก โทรไปได้ตลอด",icon:"📘"},{name:"สุรชัย ว***",i:"ส",txt:"ทำงานเสร็จเร็วกว่าที่คุยกันไว้ ประทับใจใจมาก",icon:"📱"},{name:"พรพรรณ ส***",i:"พ",txt:"หินสวย ราคายุติธรรม ช่างเป็นมืออาชีพ",icon:"📷"},{name:"จิระ ณ***",i:"จ",txt:"สั่งหินจากที่นี่ 3 ครั้งแล้ว ทุกครั้งพอใจ",icon:"📘"},{name:"ธีระ อ***",i:"ธ",txt:"หินอ่อน Carmen แต่งห้องนั่งเล่น สวยมากครับ",icon:"📘"},{name:"สุนีย์ ม***",i:"ส",txt:"งานติดตั้งเรียบร้อยมาก ช่างเซี้ยมสุดๆ",icon:"📱"},{name:"นรินทร์ ส***",i:"น",txt:"แนะนำให้ทำหินครัว งานออกมาดีเยี่ยม",icon:"📘"},{name:"วรรณา ว***",i:"ว",txt:"ไวยศิลาให้คำปรึกษาดีมาก ช่วยเลือกหินให้เหมาะ",icon:"📷"},{name:"ฐาปนา ส***",i:"ฐ",txt:"งานสำเร็จลุล่วง ประทับใจในคุณภาพมากครับ",icon:"📘"},{name:"รุ่งโรจน์ ว***",i:"ร",txt:"หินสวยทั้งน้ำ ทีมงานเป็นมืออาชีพ ขอบคุณมาก",icon:"📱"},];
      function card(n,i,t,ico){return'<div class="bg-cream p-6 rounded-md w-80 flex-shrink-0"><div class="flex gap-1 mb-3 text-terracotta text-lg">★★★★★</div><p class="text-brown/80 mb-4 text-lg leading-relaxed">"'+t+'"</p><div class="flex items-center gap-3"><div class="bg-sage/20 w-12 h-12 rounded-full flex items-center justify-center text-sage font-bold">'+i+'</div><div><p class="font-medium text-lg">'+n+'</p><div class="flex items-center gap-2 text-sm text-brown/60">'+ico+'</div></div></div></div>';}
      function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}
      var tr=document.getElementById('testimonial-track');
      if(!tr)return;
      var shuffled = shuffle(reviews.slice());
      var all='';
      for(var k=0;k<shuffled.length;k++){var r=shuffled[k];all+=card(r.name,r.i,r.txt,r.icon);}
      tr.innerHTML=all+all;
      var pos=0;
      function s(){pos+=0.5;var half=tr.scrollWidth/2;if(pos>=half)pos=0;tr.style.transform='translateX(-'+pos+'px)';requestAnimationFrame(s);}
      setTimeout(s,600);
    })();

    // Hero Slider Auto-play
    (function() {
      var slides = document.querySelectorAll('.hero-slide');
      if (slides.length === 0) return;
      var current = 0;
      function next() {
        slides[current].classList.add('hidden');
        slides[current].classList.remove('block');
        current = (current + 1) % slides.length;
        slides[current].classList.remove('hidden');
        slides[current].classList.add('block');
      }
      setInterval(next, 3000);
    })();
  </script>

  <!-- Products Preview -->
  <section class="py-24 px-6 bg-[#e0dcd7]" data-bg="#e0dcd7">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">หมวดสินค้า</p>
          <h2 class="text-3xl font-heading">สินค้าของเรา</h2>
        </div>
        <a href="/products" class="text-sm font-medium underline underline-offset-4 hover:text-sage transition-colors">ดูทั้งหมด</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/products" class="group">
          <div class="bg-[#d4d0cb] rounded-md aspect-square mb-4 overflow-hidden">
            <img src="/assets/products/category-marble.jpg" alt="หินอ่อน" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
          </div>
          <h3 class="font-heading text-xl mb-1">หินอ่อน</h3>
          <p class="text-sm text-brown/60">Marble</p>
        </a>
        <a href="/products" class="group">
          <div class="bg-[#d4d0cb] rounded-md aspect-square mb-4 overflow-hidden">
            <img src="/assets/products/category-granite.jpg" alt="หินแกรนิต" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
          </div>
          <h3 class="font-heading text-xl mb-1">หินแกรนิต</h3>
          <p class="text-sm text-brown/60">Granite</p>
        </a>
        <a href="/products" class="group">
          <div class="bg-[#d4d0cb] rounded-md aspect-square mb-4 overflow-hidden">
            <img src="/assets/products/category-quartz.jpg" alt="หินสังเคราะห์" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
          </div>
          <h3 class="font-heading text-xl mb-1">หินสังเคราะห์</h3>
          <p class="text-sm text-brown/60">Artificial & Quartz</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Portfolio Preview -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">ผลงาน</p>
          <h2 class="text-3xl font-heading">ผลงานติดตั้ง</h2>
        </div>
        <a href="/portfolio" class="text-sm font-medium underline underline-offset-4 hover:text-sage transition-colors">ดูทั้งหมด</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/portfolio" class="group">
          <div class="bg-[#d4d0cb] rounded-md aspect-[4/3] mb-4 overflow-hidden">
            <img src="/assets/portfolio/marble-01.jpg" alt="หินอ่อน | Marble" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
          </div>
          <h3 class="font-heading text-lg mb-1">หินอ่อน | Marble</h3>
        </a>
        <a href="/portfolio" class="group">
          <div class="bg-[#d4d0cb] rounded-md aspect-[4/3] mb-4 overflow-hidden">
            <img src="/assets/portfolio/granite-01.jpg" alt="หินแกรนิต | Granite" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
          </div>
          <h3 class="font-heading text-lg mb-1">หินแกรนิต | Granite</h3>
        </a>
        <a href="/portfolio" class="group">
          <div class="bg-[#d4d0cb] rounded-md aspect-[4/3] mb-4 overflow-hidden">
            <img src="/assets/portfolio/quartz-01.jpg" alt="หินเทียม | หินสังเคราะห์" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
          </div>
          <h3 class="font-heading text-lg mb-1">หินเทียม | หินสังเคราะห์</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-24 px-6 bg-terracotta/10" data-bg="#C9996B">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-heading mb-4">สนใจสินค้าหรือบริการ?</h2>
      <p class="text-brown/70 mb-8" id="contactCta">ติดต่อเราได้ตลอดเวลา {contact}</p>
      <a href="/contact" class="inline-block bg-brown text-cream px-8 py-4 rounded-md font-medium hover:bg-brown/90 transition-colors">ติดต่อเลย</a>
    </div>
  </section>

  <footer class="py-12 px-6 border-t border-[#d4d0cb]">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <p class="font-heading text-xl mb-1">ไวยศิลา</p>
        <p class="text-sm text-brown/60">WAISIRA</p>
      </div>
      <ul class="flex gap-6 text-sm text-brown/60">
        <li><a href="/services" class="hover:text-sage transition-colors">บริการ</a></li>
        <li><a href="/products" class="hover:text-sage transition-colors">สินค้า</a></li>
        <li><a href="/contact" class="hover:text-sage transition-colors">ติดต่อ</a></li>
      </ul>
