---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

const currentPage = '/contact';

import { readPages } from '../lib/jsonDb';
let pageData = { images: [], colorStyle: '', sizeText: '', information: '', contact: '', address: '', active: true, social: {} };

const allPages = await readPages();
const pageRecord = allPages.find((p: any) => p.key === 'contact');
if (pageRecord) {
  pageData = pageRecord;
}

const contactImages = pageData.images?.length > 0 ? pageData.images : [];
const colorStyle = pageData.colorStyle || '';
const information = pageData.information || '';
const contact = pageData.contact || '098-519-2696';
const social = pageData.social || {};
const phone = social.phone || contact.split(',')[0].trim() || '098-519-2696';
const line = social.line || '@waisira';
const facebook = social.facebook || '';
const instagram = social.instagram || '';
const lineQR = social.lineQR || '';
const address = pageData.address || '';
const hours = pageData.hours || '';
---

<Layout title="ติดต่อ">
  <NavBar currentPage={currentPage} />

  <section class="pt-32 pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-4">ติดต่อ</p>
      <h1 class="text-5xl font-heading leading-[1.1] mb-6">ติดต่อเรา</h1>
      
      {information && (
        <p class="text-lg text-brown/70 max-w-2xl leading-relaxed mb-12" id="infoText">{information}</p>
      )}

      {contactImages.length > 0 && (
        <div class="mb-12 rounded-md overflow-hidden" style="height: 280px;" id="heroImage">
          <img src={contactImages[0]} alt="ไวยศิลา" class="w-full h-full object-cover" />
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div class="bg-[#e0dcd7] rounded-md p-8 lg:p-10">
          <h2 class="text-2xl font-heading mb-6">ข้อมูลติดต่อ</h2>
          
          <!-- Social Icons -->
          <div class="flex flex-wrap gap-4 mb-8">
            {phone && (
              <a href={`tel:${phone.replace(/\s/g, '')}`} class="flex items-center gap-2 bg-white px-4 py-2 rounded-full hover:bg-sage/10 transition-colors">
                <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 24 24"><path d="M6.253 2.794c-.375-.375-1.039-.188-1.523.188C3.733 4.144 3.5 5.656 3.5 7.5c0 1.844.875 4.5 4.5 7.5 3.625-3 4.5-5.656 4.5-7.5 0-1.844-.233-3.356-.73-4.518-.484-.376-1.148-.563-1.523-.188l-2.5 2a2 2 0 0 1-2.017-.188l-.001.001zm3.5 2c.563 0 1 .438 1 1v1c0 .563-.438 1-1 1H6c-.563 0-1-.438-1-1v-1c0-.563.438-1 1-1h3.753z"/><path d="M9.75 15.5c.563 0 1 .438 1 1v1c0 .563-.438 1-1 1h-2c-.563 0-1-.438-1-1v-1c0-.563.438-1 1-1h2zm0-2.5h-2c-.563 0-1-.438-1-1v-1c0-.563.438-1 1-1h2c.563 0 1 .438 1 1v1c0 .563-.438 1-1 1zm0-5h-2c-.563 0-1-.438-1-1v-1c0-.563.438-1 1-1h2c.563 0 1 .438 1 1v1c0 .563-.438 1-1 1z"/></svg>
                <span class="text-sm font-medium">{phone}</span>
              </a>
            )}
            {facebook && (
              <a href={facebook} target="_blank" class="flex items-center gap-2 bg-white px-4 py-2 rounded-full hover:bg-sage/10 transition-colors">
                <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                <span class="text-sm font-medium">Facebook</span>
              </a>
            )}
            {instagram && (
              <a href={instagram} target="_blank" class="flex items-center gap-2 bg-white px-4 py-2 rounded-full hover:bg-sage/10 transition-colors">
                <svg class="w-5 h-5 text-pink-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                <span class="text-sm font-medium">Instagram</span>
              </a>
            )}
            {line && (
              <a href={`https://line.me/ti/p/${line.replace('@', '')}`} target="_blank" class="flex items-center gap-2 bg-white px-4 py-2 rounded-full hover:bg-sage/10 transition-colors">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 24 24"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
                <span class="text-sm font-medium">Line</span>
              </a>
            )}
          </div>

          <div class="space-y-6">
            <div>
              <p class="text-sm text-brown/50 mb-1">โทรศัพท์</p>
              <p class="text-xl font-medium" id="contactPhone">{phone}</p>
            </div>
            
            <div>
              <p class="text-sm text-brown/50 mb-1">Line</p>
              <p class="text-lg" id="contactLine">{line}</p>
            </div>

            {lineQR && (
              <div>
                <p class="text-sm text-brown/50 mb-2">สแกน Line QR</p>
                <img src={lineQR} alt="Line QR Code" class="w-32 h-32 object-contain rounded-md bg-white p-2" onerror="this.style.display='none'" />
              </div>
            )}
            
            <div>
              <p class="text-sm text-brown/50 mb-1">ที่อยู่</p>
              <p class="text-brown/70" id="contactAddress">{address || '66/8 หมู่ที่ 5 ตำบลบางเสาธง อำเภอบางเสาธง จังหวัดสมุทรสาคร 10550'}</p>
            </div>

            <div>
              <p class="text-sm text-brown/50 mb-1">เปิดให้บริการ</p>
              <p class="text-brown/70" id="contactHours">{hours || 'วันจันทร์ - วันเสาร์ เวลา 08:00 - 17:00 น.'}</p>
            </div>
          </div>

          {colorStyle && (
            <div class="mt-8 pt-6 border-t border-brown/20" id="colorStyleBox">
              <p class="text-sm text-brown/50">สไตล์: {colorStyle}</p>
            </div>
          )}
        </div>

        <!-- Contact Form -->
        <div class="bg-[#e0dcd7] rounded-md p-8 lg:p-10">
          <h2 class="text-2xl font-heading mb-6">ส่งข้อความ</h2>
          
          <form id="contactForm" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-brown mb-2">ชื่อ</label>
              <input type="text" name="name" required class="w-full px-4 py-3 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 bg-white" placeholder="ชื่อของคุณ" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-2">เบอร์โทร</label>
              <input type="tel" name="phone" required class="w-full px-4 py-3 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 bg-white" placeholder="08x-xxx-xxxx" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-2">อีเมล</label>
              <input type="email" name="email" class="w-full px-4 py-3 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 bg-white" placeholder="example@email.com" />
            </div>
            <div>
              <label class="block text-sm font-medium text-brown mb-2">ข้อความ</label>
              <textarea name="message" rows="4" required class="w-full px-4 py-3 border border-[#d4d0cb] rounded-md focus:outline-none focus:ring-2 focus:ring-sage/50 bg-white resize-none" placeholder="สอบถามรายละเอียด..."></textarea>
            </div>
            <button type="submit" class="w-full bg-sage text-cream py-3 rounded-md font-medium hover:bg-sage/90 transition-colors">
              ส่งข้อความ
            </button>
            <p id="formStatus" class="text-sm text-center hidden"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script is:inline>
    document.getElementById('contactForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const status = document.getElementById('formStatus');
      const submitBtn = form.querySelector('button[type="submit"]');
      
      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังส่ง...';
      status.classList.add('hidden');
      
      const formData = {
        name: form.name.value,
        phone: form.phone.value,
        email: form.email.value,
        message: form.message.value
      };
      
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });
        
        if (res.ok) {
          status.textContent = '✅ ส่งข้อความสำเร็จ! เราจะติดต่อกลับเร็วๆ นี้';
          status.classList.remove('hidden', 'text-red-500');
          status.classList.add('text-green-600');
          form.reset();
        } else {
          throw new Error('Failed');
        }
      } catch (err) {
        status.textContent = '❌ ส่งไม่สำเร็จ กรุณาลองใหม่';
        status.classList.remove('hidden', 'text-green-600');
        status.classList.add('text-red-500');
      }
      
      submitBtn.disabled = false;
      submitBtn.textContent = 'ส่งข้อความ';
    });
  </script>
</Layout>
