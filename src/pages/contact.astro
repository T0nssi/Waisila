---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

const currentPage = '/contact';

const contact = {
  phone: "098-519-2696",
  facebook: "https://www.facebook.com/waisira8",
  line: "https://line.me/ti/p/-lmFbFbMFo",
  instagram: "https://www.instagram.com/waisira_/",
  address: "45/10 ตำบลลาดสวาย อำเภอลำลูกกา จังหวัดปทุมธานี 12150",
};
---

<Layout title="ติดต่อเรา">
  <NavBar currentPage={currentPage} />

  <section class="pt-32 pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div>
          <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-4">ติดต่อ</p>
          <h1 class="text-5xl font-serif leading-[1.1] mb-6">พูดคุยกับเรา</h1>
          <p class="text-lg text-brown/70 leading-relaxed mb-12">
            หากสนใจใช้บริการหรือต้องการสอบถามรายละเอียดเพิ่มเติม ติดต่อเราได้ตลอดเวลา เราพร้อมให้คำปรึกษาฟรี
          </p>

          <div class="space-y-8">
            <div>
              <h2 class="font-serif text-xl mb-2">ที่อยู่</h2>
              <p class="text-brown/60">{contact.address}</p>
            </div>
            <div>
              <h2 class="font-serif text-xl mb-2">โทรศัพท์</h2>
              <p class="text-brown/60">{contact.phone}</p>
            </div>
            <div>
              <h2 class="font-serif text-xl mb-2">อีเมล</h2>
              <p class="text-brown/60">contact@waisira.com</p>
            </div>
            <div class="flex gap-4">
              <a href={contact.facebook} target="_blank" class="text-sm px-4 py-2 bg-[#e0dcd7] rounded-md hover:bg-[#d4d0cb] transition-colors">Facebook</a>
              <a href={contact.line} target="_blank" class="text-sm px-4 py-2 bg-[#e0dcd7] rounded-md hover:bg-[#d4d0cb] transition-colors">Line</a>
              <a href={contact.instagram} target="_blank" class="text-sm px-4 py-2 bg-[#e0dcd7] rounded-md hover:bg-[#d4d0cb] transition-colors">Instagram</a>
            </div>
          </div>
        </div>

        <div class="bg-[#e0dcd7] rounded-md p-8 lg:p-10">
          <form class="space-y-6">
            <div>
              <label class="block text-sm font-medium mb-2" for="name">ชื่อ</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-cream border border-[#d4d0cb] rounded-md focus:outline-none focus:border-sage transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2" for="phone">โทรศัพท์</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 bg-cream border border-[#d4d0cb] rounded-md focus:outline-none focus:border-sage transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2" for="email">อีเมล</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-cream border border-[#d4d0cb] rounded-md focus:outline-none focus:border-sage transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2" for="message">ข้อความ</label>
              <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 bg-cream border border-[#d4d0cb] rounded-md focus:outline-none focus:border-sage transition-colors resize-none"></textarea>
            </div>
            <button type="submit" class="w-full bg-brown text-cream py-4 rounded-md font-medium hover:bg-brown/90 transition-colors">
              ส่งข้อความ
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <footer class="py-12 px-6 border-t border-[#d4d0cb]">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <p class="font-serif text-xl mb-1">ไวยศิลา</p>
        <p class="text-sm text-brown/60">WAISIRA</p>
      </div>
      <ul class="flex gap-6 text-sm text-brown/60">
        <li><a href="/" class="hover:text-sage transition-colors">เกี่ยวกับเรา</a></li>
        <li><a href="/services" class="hover:text-sage transition-colors">บริการ</a></li>
        <li><a href="/products" class="hover:text-sage transition-colors">สินค้า</a></li>
        <li><a href="/portfolio" class="hover:text-sage transition-colors">ผลงาน</a></li>
      </ul>
    </div>
  </footer>
</Layout>