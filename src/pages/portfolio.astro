---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { readPortfolio, readPages } from '../lib/jsonDb';

const currentPage = '/portfolio';

// Get portfolio items from MongoDB/JSON
const portfolioData = await readPortfolio();
const activePortfolio = portfolioData.filter((p: any) => p.active);

// Get page info from pages
const allPages = await readPages();
const portfolioPage = allPages.find((p: any) => p.key === 'portfolio');
const heroDescription = portfolioPage?.information || 'รวบรบรวมผลงานการติดตั้งหินอ่อน หินแกรนิต และหินสังเคราะห์ ที่ผ่านการคัดเลือกและติดตั้งโดยทีมช่างมืออาชีพของเรา';

// Get unique stone categories from portfolio items
const stoneCategories = [...new Set(portfolioData.map((p: any) => p.category).filter(Boolean))];
const contact = portfolioPage?.contact || '098-519-2696';
const portfolioLabel = portfolioPage?.portfolioLabel || 'ผลงาน';
const portfolioHeading = portfolioPage?.portfolioHeading || 'ผลงานติดตั้ง';
---

<Layout title="ผลงาน | ไวยศิลา">
  <NavBar currentPage={currentPage} />

  <!-- Hero -->
  <section class="pt-40 pb-20 px-6 bg-gradient-to-br from-brown/90 via-brown/80 to-sage/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-60 bg-cover bg-center" style="background-image: url('/assets/portfolio/client-residence.jpg');"></div>
    <div class="max-w-6xl mx-auto relative z-10">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-white/70 mb-4">{portfolioLabel}</p>
      <h1 class="text-5xl lg:text-6xl font-heading text-white mb-6">{portfolioHeading.split(' ').slice(0, -1).join(' ')}<span class="text-cream">{portfolioHeading.split(' ').slice(-1).join(' ')}</span></h1>
      <p class="text-lg text-white/80 max-w-2xl leading-relaxed">
        {heroDescription}
      </p>
    </div>
  </section>

  <!-- Filter Tabs -->
  <section class="pt-8 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap gap-2 mb-8 border-b border-[#d4d0cb] pb-4">
        <button data-filter="all" class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-brown text-cream transition-colors">
          ทั้งหมด
        </button>
        {stoneCategories.map((cat: string) => (
          <button data-filter={cat} class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-white text-brown border border-[#d4d0cb] hover:bg-brown hover:text-cream transition-colors">
            {cat}
          </button>
        ))}
      </div>

      <!-- Portfolio Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8" id="portfolioGrid">
        {activePortfolio.length > 0 ? (
          activePortfolio.map((p: any) => (
            <div class="group portfolio-item bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300" data-category={p.category || ''}>
              <a href={`/portfolio/${p.slug}`} class="block">
                <div class="aspect-[4/3] overflow-hidden">
                  <img 
                    src={p.image || p.images?.[0] || '/assets/portfolio/marble-01.jpg'} 
                    alt={p.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                    loading="lazy"
                    onerror={`this.src='https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=400&fit=crop'`}
                  />
                </div>
                <div class="p-4">
                  <h3 class="font-heading text-base mb-0.5 group-hover:text-sage transition-colors">{p.title}</h3>
                  <p class="text-xs text-brown/60">{p.category || ''}</p>
                </div>
              </a>
            </div>
          ))
        ) : (
          <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <div class="aspect-[4/3] overflow-hidden">
              <img src="/assets/portfolio/marble-01.jpg" alt="หินอ่อน" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=400&fit=crop'" />
            </div>
            <div class="p-4">
              <h3 class="font-heading text-base mb-0.5">Marble Collection</h3>
              <p class="text-xs text-brown/60">หินอ่อน</p>
            </div>
          </div>
        )}
      </div>

      <!-- Empty state -->
      <div id="emptyState" class="hidden text-center py-16">
        <p class="text-brown/60">ไม่พบผลงานในหมวดนี้</p>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-24 px-6 bg-terracotta/10">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-heading mb-4">สนใจสินค้าหรือบริการ?</h2>
      <p class="text-brown/70 mb-8">ติดต่อเราได้ตลอดเวลา {contact}</p>
      <a href="/contact" class="inline-block bg-brown text-cream px-8 py-4 rounded-md font-medium hover:bg-brown/90 transition-colors">ติดต่อเลย</a>
    </div>
  </section>

  <Footer />

  <script>
    // Filter functionality
    const filterBtns = document.querySelectorAll('.filter-btn');
    const portfolioItems = document.querySelectorAll('.portfolio-item');
    const emptyState = document.getElementById('emptyState');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        
        // Update active button
        filterBtns.forEach(b => {
          b.classList.remove('bg-brown', 'text-cream');
          b.classList.add('bg-white', 'text-brown', 'border', 'border-[#d4d0cb]');
        });
        btn.classList.add('bg-brown', 'text-cream');
        btn.classList.remove('bg-white', 'text-brown', 'border', 'border-[#d4d0cb]');
        
        // Filter items
        let visibleCount = 0;
        portfolioItems.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            item.style.display = 'block';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });
        
        // Show empty state if no items
        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  </script>
</Layout>