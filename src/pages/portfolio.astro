---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

const currentPage = '/portfolio';

import { readPortfolio } from '../lib/jsonDb';
const { portfolio } = readPortfolio();
const portfolioData = portfolio || [];
---

<Layout title="ผลงาน | ไวยศิลา">
  <NavBar currentPage={currentPage} />

  <!-- Hero -->
  <section class="pt-40 pb-20 px-6 bg-gradient-to-br from-brown/90 via-brown/80 to-sage/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect fill=%22none%22 width=%2260%22 height=%2260%22/><rect fill=%22%23ffffff%22 x=%220%22 y=%220%22 width=%2230%22 height=%2230%22/><rect fill=%22%23ffffff%22 x=%2230%22 y=%2230%22 width=%2230%22 height=%2230%22/></svg>'); background-size: 60px 60px;"></div>
    </div>
    <div class="max-w-6xl mx-auto relative z-10">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-white/70 mb-4">PORTFOLIO</p>
      <h1 class="text-5xl lg:text-6xl font-heading text-white mb-6">ผลงาน<span class="text-cream">ติดตั้ง</span></h1>
      <p class="text-lg text-white/80 max-w-2xl leading-relaxed">
        รวบรวมผลงานการติดตั้งหินอ่อน หินแกรนิต และหินสังเคราะห์ ที่ผ่านการคัดเลือกและติดตั้งโดยทีมช่างมืออาชึพของเรา
      </p>
    </div>
  </section>

  <!-- Stats Strip -->
  <section class="bg-cream py-8 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-3xl font-heading text-brown">500+</p>
          <p class="text-sm text-brown/60 mt-1">โครงการสำเร็จ</p>
        </div>
        <div>
          <p class="text-3xl font-heading text-brown">30+</p>
          <p class="text-sm text-brown/60 mt-1">ปีประสบการณ์</p>
        </div>
        <div>
          <p class="text-3xl font-heading text-brown">100%</p>
          <p class="text-sm text-brown/60 mt-1">ลูกค้าพึงพอใจ</p>
        </div>
        <div>
          <p class="text-3xl font-heading text-brown">24/7</p>
          <p class="text-sm text-brown/60 mt-1">บริการตอบรับ</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Grid - Full Width -->
  <section class="py-24 px-0">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="portfolioGrid">
        {portfolioData.length > 0 ? portfolioData.filter(p => p.active).map((p: any) => (
          <div class="group bg-[#d4d0cb] rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300">
            <div class="aspect-[4/3] overflow-hidden">
              <img 
                src={p.image || '/assets/portfolio/marble-01.jpg'} 
                alt={p.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                onerror={`this.src='https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=400&fit=crop'`}
              />
            </div>
            <div class="p-5">
              <span class="text-xs font-medium tracking-wider uppercase text-terracotta/80">{p.category || p.type}</span>
              <h3 class="font-heading text-xl mt-2 mb-2">{p.title}</h3>
              <p class="text-sm text-brown/60">{p.description || 'งานติดตั้งหินคุณภาพสูง'}</p>
            </div>
          </div>
        )) : (
          <>
            <!-- Default fallback cards if no portfolio data -->
            <div class="group bg-[#d4d0cb] rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300">
              <div class="aspect-[4/3] overflow-hidden">
                <img src="/assets/portfolio/marble-01.jpg" alt="หินอ่อน" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=400&fit=crop'" />
              </div>
              <div class="p-5">
                <span class="text-xs font-medium tracking-wider uppercase text-terracotta/80">หินอ่อน</span>
                <h3 class="font-heading text-xl mt-2 mb-2">Marble Collection</h3>
                <p class="text-sm text-brown/60">งานติดตั้งหินอ่อนสำหรับพื้นและผนัง</p>
              </div>
            </div>

            <div class="group bg-[#d4d0cb] rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300">
              <div class="aspect-[4/3] overflow-hidden">
                <img src="/assets/portfolio/granite-01.jpg" alt="หินแกรนิต" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&h=400&fit=crop'" />
              </div>
              <div class="p-5">
                <span class="text-xs font-medium tracking-wider uppercase text-terracotta/80">หินแกรนิต</span>
                <h3 class="font-heading text-xl mt-2 mb-2">Granite Collection</h3>
                <p class="text-sm text-brown/60">หินแกรนิตทนทานสำหรับทุกพื้นที่</p>
              </div>
            </div>

            <div class="group bg-[#d4d0cb] rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300">
              <div class="aspect-[4/3] overflow-hidden">
                <img src="/assets/portfolio/quartz-01.jpg" alt="หินสังเคราะห์" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=600&h=400&fit=crop'" />
              </div>
              <div class="p-5">
                <span class="text-xs font-medium tracking-wider uppercase text-terracotta/80">หินสังเคราะห์</span>
                <h3 class="font-heading text-xl mt-2 mb-2">Quartz Collection</h3>
                <p class="text-sm text-brown/60">หินสังเคราะห์สำหรับครัวและห้องน้ำ</p>
              </div>
            </div>

            <div class="group bg-gradient-to-br from-sage/20 to-sage/10 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 p-6 flex flex-col justify-center">
              <div class="text-4xl mb-4">🏭</div>
              <h3 class="font-heading text-xl mb-2">โรงงาน</h3>
              <p class="text-sm text-brown/60">พื้นอุตสาหกรรม ทนต่อการใช้งานหนัก</p>
            </div>

            <div class="group bg-gradient-to-br from-terracotta/20 to-terracotta/10 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 p-6 flex flex-col justify-center">
              <div class="text-4xl mb-4">🏢</div>
              <h3 class="font-heading text-xl mb-2">อาคารสำนักงาน</h3>
              <p class="text-sm text-brown/60">งานตกแต่งภายในสุดหรู</p>
            </div>

            <div class="group bg-gradient-to-br from-brown/20 to-brown/10 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 p-6 flex flex-col justify-center">
              <div class="text-4xl mb-4">🏠</div>
              <h3 class="font-heading text-xl mb-2">บ้านเรือน</h3>
              <p class="text-sm text-brown/60">งานติดตั้งภายในบ้านทุกประเภท</p>
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Before After Section - Full Width -->
  <section class="py-24 px-0 bg-[#d4d0cb]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">ความแตกต่าง</p>
        <h2 class="text-4xl font-heading">ก่อน & หลัง</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-cream rounded-lg overflow-hidden shadow-md">
          <div class="aspect-video bg-brown/10 flex items-center justify-center">
            <div class="text-center">
              <p class="text-6xl mb-4">📷</p>
              <p class="text-brown/50">Before</p>
            </div>
          </div>
          <div class="p-5">
            <h4 class="font-heading text-lg mb-2">พื้นก่อนปรับปรุง</h4>
            <p class="text-sm text-brown/60">พื้นคอนกรีตเดิมที่มีรอยแตกร้าวและสึกกร่อน</p>
          </div>
        </div>
        <div class="bg-cream rounded-lg overflow-hidden shadow-md">
          <div class="aspect-video bg-sage/20 flex items-center justify-center">
            <div class="text-center">
              <p class="text-6xl mb-4">✨</p>
              <p class="text-sage font-medium">After</p>
            </div>
          </div>
          <div class="p-5">
            <h4 class="font-heading text-lg mb-2">พื้นหลังติดตั้งหิน</h4>
            <p class="text-sm text-brown/60">พื้นหินอ่อนเกลี้ยง สวยงาม ทนทาน น่าใช้งาน</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA - Full Width -->
  <section class="py-24 px-0 bg-gradient-to-r from-brown to-brown/80 text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-heading mb-6">ต้องการให้ช่วยติดตั้งหินในโครงการของคุณ?</h2>
      <p class="text-lg text-white/80 mb-8">ทีมช่างมืออาชีพของเราพร้อมให้บริการติดตั้งหินทุกประเภท ตั้งแต่ประเมินราคาฟรีไปจนถึงส่งมอบงาน</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-block bg-cream text-brown px-8 py-4 rounded-md font-medium hover:bg-white transition-colors">นัดประเมินราคาฟรี</a>
        <a href="tel:0985192696" class="inline-block border-2 border-white text-white px-8 py-4 rounded-md font-medium hover:bg-white hover:text-brown transition-colors">โทร 098-519-2696</a>
      </div>
    </div>
  </section>

  <footer class="py-12 px-6 border-t border-[#d4d0cb]">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <p class="font-heading text-xl mb-1">ไวยศิลา</p>
        <p class="text-sm text-brown/60">WAISIRA</p>
      </div>
      <ul class="flex gap-6 text-sm text-brown/60">
        <li><a href="/services" class="hover:text-sage transition-colors">บริการ</a></li>
        <li><a href="/products" class="hover:text-sage transition-colors">สินค้า</a></li>
        <li><a href="/contact" class="hover:text-sage transition-colors">ติดต่อ</a></li>
      </ul>
    </div>
  </footer>

  <!-- Floating WhatsApp/LINE CTA -->
  <div class="fixed bottom-6 right-6 flex flex-col gap-3 z-50">
    <a href="https://line.me/ti/p/~waisira" target="_blank" rel="noopener" class="bg-green-500 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:bg-green-600 transition-colors" title="ติดต่อ LINE">
      <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.349 0-.631-.285-.631-.629V8.108c0-.345.282-.63.631-.63.346 0 .626.285.626.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.915C23.176 14.393 24 12.458 24 10.314"/></svg>
    </a>
    <a href="https://wa.me/6685192696" target="_blank" rel="noopener" class="bg-green-600 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:bg-green-700 transition-colors" title="ติดต่อ WhatsApp">
      <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  </div>
</Layout>