---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

const currentPage = '/portfolio';

import { readPortfolio, readPages } from '../lib/jsonDb';
const { portfolio } = readPortfolio();
const portfolioData = portfolio || [];

// Get portfolio page info from pages.json
const allPages = readPages();
const portfolioPage = allPages.pages?.find((p: any) => p.key === 'portfolio');
const pageInfo = portfolioPage || {};
const heroDescription = pageInfo.information || 'รวบรวมผลงานการติดตั้งหินอ่อน หินแกรนิต และหินสังเคราะห์ ที่ผ่านการคัดเลือกและติดตั้งโดยทีมช่างมืออาชีพของเรา';
---

<Layout title="ผลงาน | ไวยศิลา">
  <NavBar currentPage={currentPage} />

  <!-- Hero -->
  <section class="pt-40 pb-20 px-6 bg-gradient-to-br from-brown/90 via-brown/80 to-sage/60 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><rect fill=%22none%22 width=%2260%22 height=%2260%22/><rect fill=%22%23ffffff%22 x=%220%22 y=%220%22 width=%2230%22 height=%2230%22/><rect fill=%22%23ffffff%22 x=%2230%22 y=%2230%22 width=%2230%22 height=%2230%22/></svg>'); background-size: 60px 60px;"></div>
    </div>
    <div class="max-w-6xl mx-auto relative z-10">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-white/70 mb-4">PORTFOLIO</p>
      <h1 class="text-5xl lg:text-6xl font-heading text-white mb-6">ผลงาน<span class="text-cream">ติดตั้ง</span></h1>
      <p class="text-lg text-white/80 max-w-2xl leading-relaxed">
        {heroDescription}
      </p>
    </div>
  </section>

  <!-- Portfolio Grid - Same as Products Page -->
  <section class="px-6 pb-24">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6" id="portfolioGrid">
        {portfolioData.length > 0 ? portfolioData.filter(p => p.active).map((p: any) => (
          <div class="group bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <div class="aspect-square overflow-hidden mb-3">
              <img 
                src={p.image || '/assets/portfolio/marble-01.jpg'} 
                alt={p.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
                onerror={`this.src='https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=400&fit=crop'`}
              />
            </div>
            <div class="px-3 pb-3">
              <h3 class="font-heading text-base mb-0.5 group-hover:text-sage transition-colors">{p.title}</h3>
              <p class="text-xs text-brown/60">{p.category || p.type}</p>
            </div>
          </div>
        )) : (
          <>
            <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="aspect-square overflow-hidden mb-3">
                <img src="/assets/portfolio/marble-01.jpg" alt="หินอ่อน" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=400&fit=crop'" />
              </div>
              <div class="px-3 pb-3">
                <h3 class="font-heading text-base mb-0.5">Marble Collection</h3>
                <p class="text-xs text-brown/60">หินอ่อน</p>
              </div>
            </div>

            <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="aspect-square overflow-hidden mb-3">
                <img src="/assets/portfolio/granite-01.jpg" alt="หินแกรนิต" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=400&h=400&fit=crop'" />
              </div>
              <div class="px-3 pb-3">
                <h3 class="font-heading text-base mb-0.5">Granite Collection</h3>
                <p class="text-xs text-brown/60">หินแกรนิต</p>
              </div>
            </div>

            <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="aspect-square overflow-hidden mb-3">
                <img src="/assets/portfolio/quartz-01.jpg" alt="หินสังเคราะห์" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=400&h=400&fit=crop'" />
              </div>
              <div class="px-3 pb-3">
                <h3 class="font-heading text-base mb-0.5">Quartz Collection</h3>
                <p class="text-xs text-brown/60">หินสังเคราะห์</p>
              </div>
            </div>

            <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="aspect-square overflow-hidden mb-3 flex items-center justify-center bg-sage/10">
                <div class="text-4xl">🏭</div>
              </div>
              <div class="px-3 pb-3">
                <h3 class="font-heading text-base mb-0.5">โรงงาน</h3>
                <p class="text-xs text-brown/60">พื้นอุตสาหกรรม</p>
              </div>
            </div>

            <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="aspect-square overflow-hidden mb-3 flex items-center justify-center bg-terracotta/10">
                <div class="text-4xl">🏢</div>
              </div>
              <div class="px-3 pb-3">
                <h3 class="font-heading text-base mb-0.5">อาคารสำนักงาน</h3>
                <p class="text-xs text-brown/60">งานตกแต่งภายใน</p>
              </div>
            </div>

            <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="aspect-square overflow-hidden mb-3 flex items-center justify-center bg-brown/10">
                <div class="text-4xl">🏠</div>
              </div>
              <div class="px-3 pb-3">
                <h3 class="font-heading text-base mb-0.5">บ้านเรือน</h3>
                <p class="text-xs text-brown/60">งานภายในบ้าน</p>
              </div>
            </div>

            <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="aspect-square overflow-hidden mb-3 flex items-center justify-center bg-sage/10">
                <div class="text-4xl">🛁</div>
              </div>
              <div class="px-3 pb-3">
                <h3 class="font-heading text-base mb-0.5">ห้องน้ำ</h3>
                <p class="text-xs text-brown/60">หินตกแต่ง</p>
              </div>
            </div>

            <div class="bg-[#d4d0cb] rounded-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <div class="aspect-square overflow-hidden mb-3 flex items-center justify-center bg-terracotta/10">
                <div class="text-4xl">🍳</div>
              </div>
              <div class="px-3 pb-3">
                <h3 class="font-heading text-base mb-0.5">ครัว</h3>
                <p class="text-xs text-brown/60">เคาน์เตอร์ครัว</p>
              </div>
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Before After Section -->
  <section class="px-6 pb-24 bg-[#d4d0cb]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-3">ความแตกต่าง</p>
        <h2 class="text-3xl font-heading">ก่อน & หลัง</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-cream rounded-md overflow-hidden">
          <div class="aspect-video bg-brown/10 flex items-center justify-center">
            <div class="text-center">
              <p class="text-5xl mb-3">📷</p>
              <p class="text-brown/50">Before</p>
            </div>
          </div>
          <div class="p-4">
            <h4 class="font-heading text-base mb-1">พื้นก่อนปรับปรุง</h4>
            <p class="text-sm text-brown/60">พื้นคอนกรีตเดิมที่มีรอยแตกร้าวและสึกกร่อน</p>
          </div>
        </div>
        <div class="bg-cream rounded-md overflow-hidden">
          <div class="aspect-video bg-sage/20 flex items-center justify-center">
            <div class="text-center">
              <p class="text-5xl mb-3">✨</p>
              <p class="text-sage font-medium">After</p>
            </div>
          </div>
          <div class="p-4">
            <h4 class="font-heading text-base mb-1">พื้นหลังติดตั้งหิน</h4>
            <p class="text-sm text-brown/60">พื้นหินอ่อนเกลี้ยง สวยงาม ทนทาน</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 pb-24 bg-gradient-to-r from-brown to-brown/80 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-heading mb-4">ต้องการให้ช่วยติดตั้งหินในโครงการของคุณ?</h2>
      <p class="text-base text-white/80 mb-6">ทีมช่างมืออาชีพของเราพร้อมให้บริการติดตั้งหินทุกประเภท</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="inline-block bg-cream text-brown px-6 py-3 rounded-md font-medium hover:bg-white transition-colors">นัดประเมินราคาฟรี</a>
        <a href="tel:0985192696" class="inline-block border-2 border-white text-white px-6 py-3 rounded-md font-medium hover:bg-white hover:text-brown transition-colors">โทร 098-519-2696</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-cream border-t border-[#d4d0cb] py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <!-- Column 1: Logo, About, Social -->
        <div class="md:col-span-4 space-y-6">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 bg-brown rounded-xl flex items-center justify-center shadow-lg">
              <span class="text-lg">🪨</span>
            </div>
            <h2 class="text-brown text-xl font-bold">ไวยศิลา</h2>
          </div>
          <p class="text-sm text-brown/70 leading-relaxed max-w-xs">
            รับตัด เจาะ เจียร์ แกะสลักหินอ่อน หินแกรนิต หินสังเคราะห์ ด้วยประสบการณ์กว่า 30 ปี บริการติดตั้งหินคุณภาพสูงทั่วประเทศไทย
          </p>
          <div>
            <p class="text-xs uppercase tracking-widest text-brown/50 font-bold mb-4">Follow Us</p>
            <div class="flex gap-3">
              <a href="https://line.me/ti/p/~waisira" target="_blank" class="p-3 bg-brown/10 rounded-full hover:bg-terracotta hover:text-white transition-all">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.349 0-.631-.285-.631-.629V8.108c0-.345.282-.63.631-.63.346 0 .626.285.626.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.915C23.176 14.393 24 12.458 24 10.314"/></svg>
              </a>
              <a href="https://wa.me/6685192696" target="_blank" class="p-3 bg-brown/10 rounded-full hover:bg-terracotta hover:text-white transition-all">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </a>
              <a href="https://www.facebook.com/waisira8" target="_blank" class="p-3 bg-brown/10 rounded-full hover:bg-terracotta hover:text-white transition-all">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Column 2: Services -->
        <div class="md:col-span-4">
          <h4 class="text-brown font-bold mb-6 flex items-center gap-2">
            <span class="w-6 h-[2px] bg-terracotta"></span>บริการ
          </h4>
          <ul class="space-y-3">
            <li><a href="/services" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">ตัดหิน <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
            <li><a href="/services" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">เจาะหิน <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
            <li><a href="/services" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">เจียร์หิน <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
            <li><a href="/services" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">แกะสลัก <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
            <li><a href="/services" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">พ่นผิวหน้า <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
            <li><a href="/services" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">ทากันซึม <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
          </ul>
        </div>

        <!-- Column 3: Navigation -->
        <div class="md:col-span-4">
          <h4 class="text-brown font-bold mb-6 flex items-center gap-2">
            <span class="w-6 h-[2px] bg-terracotta"></span>ลิงก์
          </h4>
          <ul class="space-y-3">
            <li><a href="/" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">หน้าแรก <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
            <li><a href="/products" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">สินค้า <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
            <li><a href="/portfolio" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">ผลงาน <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
            <li><a href="/contact" class="text-sm text-brown/70 hover:text-terracotta transition-colors flex items-center justify-between group">ติดต่อเรา <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span></a></li>
          </ul>
        </div>
      </div>
    </div>
  </footer>