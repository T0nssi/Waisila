      <div class="p-8 bg-terracotta/10 rounded-md border border-terracotta/20">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center">
          <div>
            <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-2">โทร</p>
            <p class="font-heading text-lg">{contact.phone}</p>
          </div>
          <div>
            <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-2">Facebook</p>
