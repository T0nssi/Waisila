  <Footer />

  <script>
    // Category tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const categoryPanels = document.querySelectorAll('[data-category-panel]');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-tab');

        tabBtns.forEach(b => {
          b.classList.remove('border-sage', 'text-sage');
          b.classList.add('border-transparent', 'text-brown/60');
        });
        btn.classList.add('border-sage', 'text-sage');
        btn.classList.remove('border-transparent', 'text-brown/60');

        categoryPanels.forEach(panel => {
          panel.classList.toggle('hidden', panel.getAttribute('data-category-panel') !== category);
        });
      });
    });
  </script>
</Layout>
