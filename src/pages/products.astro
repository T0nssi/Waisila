---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { readProducts, readPages, readSettings } from '../lib/jsonDb';

const currentPage = '/products';

const allProducts = await readProducts();
const marbleProducts = allProducts.filter((p: any) => p.category === 'marble' && p.active);
const graniteProducts = allProducts.filter((p: any) => p.category === 'granite' && p.active);
const artificialProducts = allProducts.filter((p: any) => p.category === 'artificial' && p.active);
const quartzProducts = allProducts.filter((p: any) => p.category === 'quartz' && p.active);

// Read tab labels from service page data
const allPages = await readPages();
const serviceData = allPages.find((p: any) => p.key === 'service') || {};
const settings = await readSettings() || {};
const marbleTabLabel = serviceData.marbleTab || 'หินอ่อน (Marble)';
const graniteTabLabel = serviceData.graniteTab || 'หินแกรนิต (Granite)';
const artificialTabLabel = serviceData.artificialTab || 'หินเทียม (Artificial)';
const quartzTabLabel = serviceData.quartzTab || 'หินควอทซ์ (Quartz)';

const contact = {
  phone: settings.social?.phone || '098-519-2696',
  facebook: settings.social?.facebook || 'https://www.facebook.com/waisira8',
  line: settings.social?.line || 'https://line.me/ti/p/-lmFbFbMFo',
  instagram: settings.social?.instagram || 'https://www.instagram.com/waisira_/',
};
---

<Layout title="สินค้า">
  <NavBar currentPage={currentPage} />

  <section class="pt-32 pb-16 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-brown/50 mb-4">หมวดสินค้า</p>
      <h1 class="text-5xl font-heading leading-[1.1] mb-4">สินค้าของเรา</h1>
      <p class="text-lg text-brown/70 max-w-2xl">ไวยศิลานำเข้าและจำหน่ายหินอ่อน หินแกรนิต หินเทียม และหินควอทซ์คุณภาพ premium จากทั่วโลก</p>
    </div>
  </section>

  <section class="px-6 pb-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex gap-4 border-b border-[#d4d0cb]">
        <button onclick="showCategory('marble')" id="tab-marble" class="pb-4 px-2 text-sm font-medium border-b-2 border-sage text-sage">{marbleTabLabel} ({marbleProducts.length})</button>
        <button onclick="showCategory('granite')" id="tab-granite" class="pb-4 px-2 text-sm font-medium border-b-2 border-transparent text-brown/60 hover:text-brown transition-colors">{graniteTabLabel} ({graniteProducts.length})</button>
        <button onclick="showCategory('artificial')" id="tab-artificial" class="pb-4 px-2 text-sm font-medium border-b-2 border-transparent text-brown/60 hover:text-brown transition-colors">{artificialTabLabel} ({artificialProducts.length})</button>
        <button onclick="showCategory('quartz')" id="tab-quartz" class="pb-4 px-2 text-sm font-medium border-b-2 border-transparent text-brown/60 hover:text-brown transition-colors">{quartzTabLabel} ({quartzProducts.length})</button>
      </div>
    </div>
  </section>

  <section id="cat-marble" class="px-6 pb-24">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {marbleProducts.map((p: any) => (
          <a href={`/product/${p.slug}`} class="group block">
            <div class="bg-[#d4d0cb] rounded-md aspect-square mb-3 overflow-hidden">
              {p.image ? (
                <img loading="lazy" decoding="async" src={p.image} alt={p.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
              ) : (
                <div class="w-full h-full bg-[#d4d0cb]"></div>
              )}
            </div>
            <h3 class="font-heading text-base mb-0.5 group-hover:text-sage transition-colors">{p.name}</h3>
            <p class="text-xs text-brown/60">{p.en || ''}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="cat-granite" class="px-6 pb-24 hidden">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {graniteProducts.map((p: any) => (
          <a href={`/product/${p.slug}`} class="group block">
            <div class="bg-[#d4d0cb] rounded-md aspect-square mb-3 overflow-hidden">
              {p.image ? (
                <img loading="lazy" decoding="async" src={p.image} alt={p.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
              ) : (
                <div class="w-full h-full bg-[#d4d0cb]"></div>
              )}
            </div>
            <h3 class="font-heading text-base mb-0.5 group-hover:text-sage transition-colors">{p.name}</h3>
            <p class="text-xs text-brown/60">{p.en || ''}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="cat-artificial" class="px-6 pb-24 hidden">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {artificialProducts.map((p: any) => (
          <a href={`/product/${p.slug}`} class="group block">
            <div class="bg-[#d4d0cb] rounded-md aspect-square mb-3 overflow-hidden">
              {p.image ? (
                <img loading="lazy" decoding="async" src={p.image} alt={p.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
              ) : (
                <div class="w-full h-full bg-[#d4d0cb]"></div>
              )}
            </div>
            <h3 class="font-heading text-base mb-0.5 group-hover:text-sage transition-colors">{p.name}</h3>
            <p class="text-xs text-brown/60">{p.en || ''}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="cat-quartz" class="px-6 pb-24 hidden">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {quartzProducts.map((p: any) => (
          <a href={`/product/${p.slug}`} class="group block">
            <div class="bg-[#d4d0cb] rounded-md aspect-square mb-3 overflow-hidden">
              {p.image ? (
                <img loading="lazy" decoding="async" src={p.image} alt={p.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
              ) : (
                <div class="w-full h-full bg-[#d4d0cb]"></div>
              )}
            </div>
            <h3 class="font-heading text-base mb-0.5 group-hover:text-sage transition-colors">{p.name}</h3>
            <p class="text-xs text-brown/60">{p.en || ''}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
