---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "ไวยศิลา | ผู้จำหน่ายและติดตั้งหินอ่อน หินแกรนิต และหินสังเคราะห์ ครบวงจร" } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | ไวยศิลา WAISIRA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-cream text-brown font-sans antialiased">
    <slot />
    <!-- Floating Contact Button -->
    <a href="/contact" class="fixed bottom-6 right-6 z-50 bg-sage text-cream px-4 py-3 rounded-full shadow-lg flex items-center gap-2 hover:bg-sage/90 transition-colors font-medium text-sm">
      <span>💬 ติดต่อเรา</span>
    </a>
  </body>
</html>

<style is:global>
  :root {
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Inter', system-ui, sans-serif;
    --color-cream: #EDE9E6;
    --color-terracotta: #C9996B;
    --color-brown: #5C4F4A;
    --color-sage: #5C766D;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: var(--font-sans);
  }
  
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-serif);
    font-weight: 600;
  }
</style>