---
import { readSettingsSync } from '../lib/jsonDb';

interface Props {
  currentPage?: string;
}

const { currentPage = '/' } = Astro.props;

const settings = readSettingsSync();
const trustBadges = settings.trustBadges || [
  { text: 'รับประกันงาน', icon: '✅' },
  { text: 'ส่งมอบตรงเวลา', icon: '✅' },
  { text: 'วัสดุเกรด A', icon: '✅' },
  { text: 'ลูกค้ากว่า 500+ ราย', icon: '✅' },
];
const phone = settings.social?.phone || '098-519-2696';

const defaultNavItems = [
  { href: '/', label: 'หน้าแรก' },
  { href: '/about', label: 'เกี่ยวกับเรา' },
  { href: '/services', label: 'บริการ' },
  { href: '/products', label: 'สินค้า' },
  { href: '/portfolio', label: 'ผลงาน' },
  { href: '/contact', label: 'ติดต่อ' },
];
const navItems = settings.navItems?.length > 0 ? settings.navItems : defaultNavItems;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-cream/95 backdrop-blur-sm border-b border-[#d4d0cb]">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-2xl font-heading font-bold tracking-tight">ไวยศิลา</a>
    <ul class="flex gap-8 text-sm font-medium">
      {navItems.map(item => (
        <li>
          <a 
            href={item.href} 
            class:list={[
              'hover:text-sage transition-colors',
              { 'text-sage': currentPage === item.href }
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<!-- Trust Badge Strip -->
<div class="fixed top-[73px] left-0 right-0 z-40 bg-sage/10 border-b border-sage/20 py-2 px-6">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-center gap-x-6 gap-y-1 text-xs font-medium text-brown/80">
    {trustBadges.map((badge: any, i: number) => (
      <>
        <span class="flex items-center gap-1">{badge.icon} {badge.text}</span>
        {i < trustBadges.length - 1 && <span class="hidden sm:inline">•</span>}
      </>
    ))}
    <span class="hidden sm:inline">•</span>
    <span class="flex items-center gap-1">📞 {phone}</span>
  </div>
</div>