---
interface Props {
  currentPage?: string;
}

const { currentPage = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'เกี่ยวกับเรา' },
  { href: '/services', label: 'บริการ' },
  { href: '/products', label: 'สินค้า' },
  { href: '/portfolio', label: 'ผลงาน' },
  { href: '/contact', label: 'ติดต่อ' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-cream/95 backdrop-blur-sm border-b border-[#d4d0cb]">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-2xl font-serif font-bold tracking-tight">ไวยศิลา</a>
    <ul class="flex gap-8 text-sm font-medium">
      {navItems.map(item => (
        <li>
          <a 
            href={item.href} 
            class:list={[
              'hover:text-sage transition-colors',
              { 'text-sage': currentPage === item.href }
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>